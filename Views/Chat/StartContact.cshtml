@{
    ViewData["Title"] = "Contactar Comercial";
    var propertyId = ViewBag.PropertyId;
    var propertyName = ViewBag.PropertyName as string;
    var propertyImage = ViewBag.PropertyImage as string;
    var agencyLogo = ViewBag.AgencyLogo as string;
    var comercialName = ViewBag.ComercialName as string;
    var comercialId = ViewBag.ComercialId as string;
    var canSend = ViewBag.CanSend ?? false;
}
<link rel="stylesheet" href="~/css/chat-startcontact.css" asp-append-version="true" />
<div class="container contact-container">
    <div class="details-header d-flex align-items-center mb-3 contact-header">
        @if (!string.IsNullOrEmpty(agencyLogo))
        {
            <img src="@agencyLogo" alt="Agência" class="agency-logo-contact" />
        }
        <h2 class="contact-title">@propertyName</h2>
    </div>
    <div class="d-flex align-items-center mb-3 contact-info">
        <img src="@propertyImage" alt="Casa" class="property-image-contact" />
        <div>
            <div class="comercial-label">Comercial responsável:</div>
            <div class="comercial-name">@comercialName</div>
        </div>
    </div>
    @if (canSend)
    {
        <form method="post" action="/Chat/StartContactSend" class="mb-3">
            <input type="hidden" name="propertyId" value="@propertyId" />
            <input type="hidden" name="comercialId" value="@comercialId" />
            <div class="mb-2">
                <textarea name="message" class="form-control textarea-no-resize" rows="3" placeholder="Escreva a sua mensagem para o comercial..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-100">Enviar</button>
        </form>
    }
    else
    {
        <div class="alert alert-warning text-center alert-custom">Apenas utilizadores podem iniciar contacto.</div>
    }
</div> 