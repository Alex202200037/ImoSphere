@{
    ViewData["Title"] = "Contactar Comercial";
    var propertyId = ViewBag.PropertyId;
    var propertyName = ViewBag.PropertyName as string;
    var propertyImage = ViewBag.PropertyImage as string;
    var agencyLogo = ViewBag.AgencyLogo as string;
    var comercialName = ViewBag.ComercialName as string;
    var comercialId = ViewBag.ComercialId as string;
    var canSend = ViewBag.CanSend ?? false;
}
<div class="container" style="max-width:600px;margin:40px auto;">
    <div class="details-header d-flex align-items-center mb-3" style="gap:18px;justify-content:center;">
        @if (!string.IsNullOrEmpty(agencyLogo))
        {
            <img src="@agencyLogo" alt="Agência" style="height:40px;width:auto;max-width:60px;object-fit:contain;vertical-align:middle;" />
        }
        <h2 style="margin:0 0 0 12px;font-size:1.3rem;font-weight:700;">@propertyName</h2>
    </div>
    <div class="d-flex align-items-center mb-3" style="gap:16px;">
        <img src="@propertyImage" alt="Casa" style="width:60px;height:60px;object-fit:cover;border-radius:12px;border:2px solid #333;" />
        <div>
            <div style="font-size:1.05rem;color:#bbb;">Comercial responsável:</div>
            <div style="font-size:1.1rem;font-weight:600;">@comercialName</div>
        </div>
    </div>
    @if (canSend)
    {
        <form method="post" action="/Chat/StartContactSend" class="mb-3">
            <input type="hidden" name="propertyId" value="@propertyId" />
            <input type="hidden" name="comercialId" value="@comercialId" />
            <div class="mb-2">
                <textarea name="message" class="form-control" rows="3" placeholder="Escreva a sua mensagem para o comercial..." required style="resize:none;"></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-100">Enviar</button>
        </form>
    }
    else
    {
        <div class="alert alert-warning text-center" style="background:#232323;color:#bbb;border:none;">Apenas utilizadores podem iniciar contacto.</div>
    }
</div>
<style>
    .details-header { margin-bottom: 18px; }
</style> 