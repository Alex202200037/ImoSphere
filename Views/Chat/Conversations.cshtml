@using ImoSphere.Models
@model List<ConversationListItemViewModel>
@{
    ViewData["Title"] = "Conversas";
    var conversations = Model ?? new List<ConversationListItemViewModel>();
    var currentUserId = ViewBag.CurrentUserId as string;
}

<link rel="stylesheet" href="~/css/chat-conversations.css" asp-append-version="true" />

<div class="container">
    <div class="chat-header">
        <h1 class="chat-title">Conversas</h1>
    </div>
    
    @if (conversations != null && conversations.Any())
    {
        <div class="conversations-list premium-list">
            @foreach (var conv in conversations)
            {
                var isUnread = conv.UnreadCount > 0;
                <a href="/Chat/Index?conversationId=@conv.Id" class="conversation-item premium-card@(isUnread ? " unread" : "")">
                    <div class="conversation-avatar premium-avatar@(isUnread ? " unread-glow" : "")">
                        <img src="@conv.PropertyImage" alt="@conv.PropertyName" />
                    </div>
                    <div class="conversation-content premium-content">
                        <div class="conversation-header premium-header">
                            <h3 class="premium-title">@conv.PropertyName</h3>
                            @if (!string.IsNullOrEmpty(conv.AgencyLogo))
                            {
                                <img src="@conv.AgencyLogo" alt="Agência" class="premium-agency-logo" />
                            }
                        </div>
                        <div class="conversation-meta premium-meta">
                            <p class="premium-last-message">@conv.LastMessage</p>
                            @if (conv.LastMessageTime != null)
                            {
                                <span class="premium-time">@(((DateTime)conv.LastMessageTime).ToLocalTime().ToString("dd/MM HH:mm"))</span>
                            }
                        </div>
                    </div>
                    @if (isUnread)
                    {
                        <div class="unread-badge pulse premium-badge">@conv.UnreadCount</div>
                    }
                </a>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">💬</div>
            <h3>Nenhuma conversa</h3>
            <p>Ainda não tem conversas ativas. Contacte um comercial para começar!</p>
            <a href="/Home/Properties" class="btn btn-primary">Ver Propriedades</a>
        </div>
    }
</div> 