@using ImoSphere.Models
@model List<ConversationListItemViewModel>
@{
    ViewData["Title"] = "Conversas";
    var conversations = Model ?? new List<ConversationListItemViewModel>();
    var currentUserId = ViewBag.CurrentUserId as string;
}
<div class="container">
    <div class="chat-header d-flex align-items-center mb-4" style="gap:18px;">
        <h1 style="margin:0;font-size:1.8rem;font-weight:700;">Conversas</h1>
    </div>
    
    @if (conversations != null && conversations.Any())
    {
        <div class="conversations-list">
            @foreach (var conv in conversations)
            {
                <a href="/Chat/Index?conversationId=@conv.Id" class="conversation-item">
                    <div class="conversation-avatar">
                        <img src="@conv.PropertyImage" alt="@conv.PropertyName" style="width:60px;height:60px;object-fit:cover;border-radius:12px;border:2px solid #333;" />
                    </div>
                    <div class="conversation-content">
                        <div class="conversation-header">
                            <h3 style="margin:0;font-size:1.2rem;font-weight:600;">@conv.PropertyName</h3>
                            @if (!string.IsNullOrEmpty(conv.AgencyLogo))
                            {
                                <img src="@conv.AgencyLogo" alt="Agência" style="height:24px;width:auto;max-width:40px;object-fit:contain;" />
                            }
                        </div>
                        <div class="conversation-meta">
                            <p style="margin:0;color:#bbb;font-size:0.95rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@conv.LastMessage</p>
                            @if (conv.LastMessageTime != null)
                            {
                                <span style="font-size:0.85rem;color:#666;">@(((DateTime)conv.LastMessageTime).ToLocalTime().ToString("dd/MM HH:mm"))</span>
                            }
                        </div>
                    </div>
                    @if (conv.UnreadCount > 0)
                    {
                        <div class="unread-badge">@conv.UnreadCount</div>
                    }
                </a>
            }
        </div>
    }
    else
    {
        <div class="empty-state text-center" style="padding:60px 20px;">
            <div style="font-size:4rem;margin-bottom:20px;">💬</div>
            <h3 style="margin-bottom:10px;color:#e0e0e0;">Nenhuma conversa</h3>
            <p style="color:#bbb;margin-bottom:30px;">Ainda não tem conversas ativas. Contacte um comercial para começar!</p>
            <a href="/Home/Properties" class="btn btn-primary">Ver Propriedades</a>
        </div>
    }
</div>

<style>
    .conversations-list { display: flex; flex-direction: column; gap: 12px; }
    .conversation-item { 
        display: flex; 
        align-items: center; 
        gap: 16px; 
        padding: 16px; 
        background: #181818; 
        border-radius: 12px; 
        text-decoration: none; 
        color: inherit; 
        transition: all 0.2s ease;
        border: 1px solid #232323;
    }
    .conversation-item:hover { 
        background: #1f1f1f; 
        transform: translateY(-1px); 
        box-shadow: 0 4px 12px #0002;
        text-decoration: none;
        color: inherit;
    }
    .conversation-content { flex: 1; min-width: 0; }
    .conversation-header { 
        display: flex; 
        align-items: center; 
        gap: 10px; 
        margin-bottom: 6px; 
    }
    .conversation-meta { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
    }
    .unread-badge { 
        background: var(--secondary-color); 
        color: white; 
        border-radius: 50%; 
        width: 24px; 
        height: 24px; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        font-size: 0.8rem; 
        font-weight: 600; 
    }
    .empty-state { background: #181818; border-radius: 12px; border: 1px solid #232323; }
</style> 