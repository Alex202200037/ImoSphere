@model ImoSphere.Models.ChatViewModel
@{
    ViewData["Title"] = "Chat";
    string GetRoleLabel(string userId)
    {
        if (userId == Model.ComercialId && Model.IsAdmin)
            return "Admin";
        if (userId == Model.ComercialId)
            return "Comercial";
        return null;
    }
    string GetRoleColor(string role)
    {
        if (role == "Admin") return "#8be9fd";
        if (role == "Comercial") return "#bbb";
        return "#fff";
    }
}
@Html.AntiForgeryToken()

<link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />

<div class="chat-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <!-- Chat Header -->
                <div class="card chat-header-card mb-4">
                    <div class="card-body">
                        <div class="chat-header">
                            <div class="chat-avatar">
                                @if (Model.Property?.Images != null && Model.Property.Images.Any())
                                {
                                    <img src="@Model.Property.Images.First().ImageUrl" alt="Property" />
                                }
                                else
                                {
                                    <i class="fas fa-home fa-2x"></i>
                                }
                            </div>
                            <div class="chat-info">
                                <h3 class="chat-title">@Model.Property?.Name</h3>
                                <p class="chat-location">
                                    <i class="fas fa-map-marker-alt me-1"></i>@Model.Property?.Location
                                </p>
                                <div class="chat-meta">
                                    <span class="chat-price">€@Model.Property?.Price.ToString("N0")</span>
                                    @if (Model.Property?.Agency != null)
                                    {
                                        <img src="@GetAgencyLogo(Model.Property.Agency.Name)" alt="@Model.Property.Agency.Name" class="agency-logo" />
                                    }
                                </div>
                            </div>
                            <div class="chat-actions">
                                <a href="@Url.Action("Details", "Properties", new { id = Model.Property?.Id })" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye me-1"></i>Ver Propriedade
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chat Messages -->
                <div class="card chat-messages-card">
                    <div class="card-header">
                        <div class="chat-participants">
                            <div class="participant">
                                <div class="participant-avatar">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div class="participant-info">
                                    <span class="participant-name">@Model.UserName</span>
                                    <span class="participant-role">Cliente</span>
                                </div>
                            </div>
                            <div class="chat-separator">
                                <i class="fas fa-comments"></i>
                            </div>
                            <div class="participant">
                                <div class="participant-avatar">
                                    <i class="fas fa-user-tie"></i>
                                </div>
                                <div class="participant-info">
                                    <span class="participant-name">@Model.ComercialName</span>
                                    <span class="participant-role">@(Model.IsAdmin ? "Admin" : "Comercial")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-body chat-messages-body">
                        <div id="messagesContainer" class="messages-container">
                            @foreach (var message in Model.Messages)
                            {
                                var isOwnMessage = message.SenderId == Model.UserId;
                                var role = GetRoleLabel(message.SenderId);
                                var roleColor = GetRoleColor(role);
                                
                                <div class="message @(isOwnMessage ? "message-own" : "message-other")">
                                    <div class="message-avatar">
                                        @if (isOwnMessage)
                                        {
                                            <i class="fas fa-user"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-user-tie"></i>
                                        }
                                    </div>
                                    <div class="message-content">
                                        <div class="message-header">
                                            <span class="message-sender" style="color:@roleColor">@message.SenderName</span>
                                            <span class="message-role">@role</span>
                                            <span class="message-time">@message.SentAt.ToLocalTime().ToString("HH:mm")</span>
                                        </div>
                                        <div class="message-text">@message.Text</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    
                    @if (Model.CanSend)
                    {
                        <div class="card-footer">
                            <form id="messageForm" class="message-form">
                                <div class="input-group">
                                    <textarea id="messageInput" class="form-control message-input" 
                                              placeholder="Escreva a sua mensagem..." rows="2"></textarea>
                                    <button type="submit" class="btn btn-primary send-btn" disabled>
                                        <i class="fas fa-paper-plane"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="card-footer">
                            <div class="chat-disabled">
                                <i class="fas fa-lock me-2"></i>
                                <span>Chat não disponível para este utilizador</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetAgencyLogo(string agencyName)
    {
        return agencyName?.ToLower() switch
        {
            "remax" => "/images/remax.png",
            "era" => "/images/era.png",
            "century 21" => "/images/century21.png",
            "fine and country" => "/images/fine and country.png",
            "kw" => "/images/kw.png",
            _ => "/images/remax.png"
        };
    }
}

@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        const messagesContainer = document.getElementById('messagesContainer');
        const messageForm = document.getElementById('messageForm');
        const messageInput = document.getElementById('messageInput');
        const sendBtn = document.querySelector('.send-btn');

        // Auto-resize textarea
        messageInput.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            
            // Enable/disable send button
            sendBtn.disabled = this.value.trim().length === 0;
        });

        // Send message
        messageForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const message = messageInput.value.trim();
            if (message.length === 0) return;

            // Add message to UI immediately
            addMessageToUI('@Model.UserName', message, true);
            
            // Clear input
            messageInput.value = '';
            messageInput.style.height = 'auto';
            sendBtn.disabled = true;

            // Send to server
            connection.invoke("SendMessage", '@Model.ConversationId', message)
                .catch(err => console.error(err));
        });

        // Receive message
        connection.on("ReceiveMessage", function(senderName, message, isOwnMessage) {
            addMessageToUI(senderName, message, isOwnMessage);
        });

        function addMessageToUI(senderName, message, isOwnMessage) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${isOwnMessage ? 'message-own' : 'message-other'}`;
            
            const now = new Date();
            const timeString = now.toLocaleTimeString('pt-PT', { hour: '2-digit', minute: '2-digit' });
            
            messageDiv.innerHTML = `
                <div class="message-avatar">
                    <i class="fas fa-${isOwnMessage ? 'user' : 'user-tie'}"></i>
                </div>
                <div class="message-content">
                    <div class="message-header">
                        <span class="message-sender">${senderName}</span>
                        <span class="message-time">${timeString}</span>
                    </div>
                    <div class="message-text">${message}</div>
                </div>
            `;
            
            messagesContainer.appendChild(messageDiv);
            scrollToBottom();
        }

        function scrollToBottom() {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        // Start connection
        connection.start().then(function() {
            console.log("SignalR Connected");
            scrollToBottom();
        }).catch(function(err) {
            console.error(err.toString());
        });

        // Scroll to bottom on page load
        window.addEventListener('load', scrollToBottom);
    </script>
}