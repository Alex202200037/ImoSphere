@model ImoSphere.Models.ChatViewModel
@{
    ViewData["Title"] = "Chat";
    string GetRoleLabel(string userId)
    {
        if (userId == Model.ComercialId && Model.IsAdmin)
            return "Admin";
        if (userId == Model.ComercialId)
            return "Comercial";
        return null;
    }
    string GetRoleColor(string role)
    {
        if (role == "Admin") return "#8be9fd";
        if (role == "Comercial") return "#8844ff";
        if (role == "Cliente" || role == "User" || role == "Cliente/User") return "#4be37a";
        return "#fff";
    }
    string lastSenderId = null;
}
@Html.AntiForgeryToken()

<link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />

<div class="chat-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <!-- Chat Header -->
                <div class="card chat-header-card mb-4">
                    <div class="card-body">
                        <div class="chat-header">
                            <div class="chat-avatar">
                                @if (Model.Property?.Images != null && Model.Property.Images.Any())
                                {
                                    <img src="@Model.Property.Images.First().ImageUrl" alt="Property" />
                                }
                                else
                                {
                                    <i class="fas fa-home fa-2x"></i>
                                }
                            </div>
                            <div class="chat-info">
                                <h3 class="chat-title">@Model.Property?.Name</h3>
                                <p class="chat-location">
                                    <i class="fas fa-map-marker-alt me-1"></i>@Model.Property?.Location
                                </p>
                                <div class="chat-meta">
                                    <span class="chat-price">€@Model.Property?.Price.ToString("N0")</span>
                                    @if (Model.Property?.Agency != null)
                                    {
                                        <img src="@GetAgencyLogo(Model.Property.Agency.Name)" alt="@Model.Property.Agency.Name" class="agency-logo" />
                                    }
                                </div>
                            </div>
                            <div class="chat-actions">
                                <a href="@Url.Action("Details", "Properties", new { id = Model.Property?.Id })" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye me-1"></i>Ver Propriedade
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chat Messages -->
                <div class="card chat-messages-card">
                    <div class="card-header">
                        <div class="chat-participants">
                            <div class="participant">
                                <div class="participant-avatar">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div class="participant-info">
                                    <span class="participant-name">
                                        @Model.UserName
                                    </span>
                                    <span class="participant-role">Cliente</span>
                                </div>
                            </div>
                            <div class="chat-separator">
                                <i class="fas fa-comments"></i>
                            </div>
                            <div class="participant">
                                <div class="participant-avatar">
                                    <i class="fas fa-user-tie"></i>
                                </div>
                                <div class="participant-info">
                                    <span class="participant-name">
                                        @Model.ComercialName
                                    </span>
                                    <span class="participant-role">Comercial</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ComercialAdminName))
                            {
                                <div class="chat-separator">
                                    <i class="fas fa-link"></i>
                                </div>
                                <div class="participant">
                                    <div class="participant-avatar">
                                        <i class="fas fa-user-shield"></i>
                                    </div>
                                    <div class="participant-info">
                                        <span class="participant-name">
                                            @Model.ComercialAdminName
                                        </span>
                                        <span class="participant-role admin-role">Administrador</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <div class="card-body chat-messages-body">
                        @if (Model.Messages.Any(m => m.SenderId != Model.CurrentUserId && !m.IsRead))
                        {
                            var unreadCount = Model.Messages.Count(m => m.SenderId != Model.CurrentUserId && !m.IsRead);
                            <div class="unread-messages-banner">
                                <i class="fas fa-envelope-open-text me-2"></i>
                                <span>@unreadCount mensagem(ens) por ler nesta conversa</span>
                            </div>
                        }
                        <div id="messagesContainer" class="messages-container">
                            @{
                                int lastIndex = Model.Messages.Count - 1;
                                var groupedMessages = new List<(string SenderId, List<ImoSphere.Models.ChatMessage> Messages)>();
                                if (Model.Messages.Any())
                                {
                                    string currentSender = Model.Messages[0].SenderId;
                                    var currentGroup = new List<ImoSphere.Models.ChatMessage>();
                                    foreach (var msg in Model.Messages)
                                    {
                                        if (msg.SenderId != currentSender)
                                        {
                                            groupedMessages.Add((currentSender, currentGroup));
                                            currentSender = msg.SenderId;
                                            currentGroup = new List<ImoSphere.Models.ChatMessage>();
                                        }
                                        currentGroup.Add(msg);
                                    }
                                    groupedMessages.Add((currentSender, currentGroup));
                                }
                            }
                            @foreach (var group in groupedMessages)
                            {
                                var isOwnMessage = group.SenderId == Model.CurrentUserId;
                                var senderRole = Model.SenderRoles != null && Model.SenderRoles.ContainsKey(group.SenderId) ? Model.SenderRoles[group.SenderId] : "";
                                var roleColor = GetRoleColor(senderRole);
                                string avatarClass = senderRole == "Admin" ? "fa-user-shield" : (senderRole == "Comercial" ? "fa-user-tie" : "fa-user");
                                var firstMsg = group.Messages.First();
                                var lastMsg = group.Messages.Last();
                                bool showRead = isOwnMessage && Model.Messages.Last() == lastMsg && lastMsg.IsRead;
                                <div class="message-group @(isOwnMessage ? "own-group" : "other-group")">
                                    @if (!isOwnMessage)
                                    {
                                        <div class="group-header">
                                            <span class="message-avatar"><i class="fas @avatarClass"></i></span>
                                            <span class="message-sender" style="color:@roleColor">@firstMsg.SenderName</span>
                                            <span class="message-role">@senderRole</span>
                                        </div>
                                    }
                                    @for (int i = 0; i < group.Messages.Count; i++)
                                    {
                                        var msg = group.Messages[i];
                                        bool isFirst = i == 0;
                                        bool isLast = i == group.Messages.Count - 1;
                                        <div class="message-bubble @(isOwnMessage ? "own-bubble" : "other-bubble")@(isFirst ? " bubble-first" : "")@(isLast ? " bubble-last" : "")">
                                            <div class="bubble-text">@msg.Text</div>
                                            @if (isLast)
                                            {
                                                <span class="bubble-time">@msg.SentAt.ToLocalTime().ToString("HH:mm")</span>
                                                @if (showRead)
                                                {
                                                    <span class="message-read-check ms-2" title="Lida"><i class="fas fa-check-double"></i> Lida</span>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    
                    @if (Model.CanSend)
                    {
                        <div class="card-footer">
                            <form id="messageForm" class="message-form">
                                <div class="input-group">
                                    <textarea id="messageInput" class="form-control message-input" 
                                              placeholder="Escreva a sua mensagem..." rows="2"></textarea>
                                    <button type="submit" class="btn btn-primary send-btn" disabled>
                                        <i class="fas fa-paper-plane"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="card-footer">
                            <div class="chat-disabled">
                                <i class="fas fa-lock me-2"></i>
                                <span>Chat não disponível para este utilizador</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetAgencyLogo(string agencyName)
    {
        return agencyName?.ToLower() switch
        {
            "remax" => "/images/remax.png",
            "era" => "/images/era.png",
            "century 21" => "/images/century21.png",
            "fine and country" => "/images/fine and country.png",
            "kw" => "/images/kw.png",
            _ => "/images/remax.png"
        };
    }
}

@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        const messagesContainer = document.getElementById('messagesContainer');
        const messageForm = document.getElementById('messageForm');
        const messageInput = document.getElementById('messageInput');
        const sendBtn = document.querySelector('.send-btn');

        // Auto-resize textarea
        messageInput.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            
            // Enable/disable send button
            sendBtn.disabled = this.value.trim().length === 0;
        });

        // Send message
        messageForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const message = messageInput.value.trim();
            if (message.length === 0) return;

            // Add message to UI immediately
            addMessageToUI(currentUserName, message, true);
            
            // Clear input
            messageInput.value = '';
            messageInput.style.height = 'auto';
            sendBtn.disabled = true;

            // Send to server
            connection.invoke("SendMessage", '@Model.ConversationId', message)
                .catch(err => console.error(err));
        });

        // Receive message
        connection.on("ReceiveMessage", function(senderName, message, isOwnMessage) {
            addMessageToUI(senderName, message, isOwnMessage);
        });

        const currentUserName = '@User.Identity.Name';
        const currentUserRole = '@(Model.SenderRoles != null && Model.SenderRoles.ContainsKey(Model.CurrentUserId) ? Model.SenderRoles[Model.CurrentUserId] : "")';
        function getRoleColor(role) {
            if (role === "Admin") return "#8be9fd";
            if (role === "Comercial") return "#8844ff";
            if (role === "Cliente" || role === "User" || role === "Cliente/User") return "#4be37a";
            return "#fff";
        }
        let lastSenderId = null;
        function addMessageToUI(senderName, message, isOwnMessage, senderId = null, senderRole = null) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${isOwnMessage ? 'message-own' : 'message-other'}`;
            const now = new Date();
            const timeString = now.toLocaleTimeString('pt-PT', { hour: '2-digit', minute: '2-digit' });
            if (!senderRole) {
                senderRole = "User";
                if (senderName === currentUserName) senderRole = currentUserRole;
            }
            let avatarClass = 'fa-user';
            if (senderRole === 'Comercial') avatarClass = 'fa-user-tie';
            if (senderRole === 'Admin') avatarClass = 'fa-user-shield';
            const roleColor = getRoleColor(senderRole);
            let showHeader = true;
            if (senderId !== null && lastSenderId === senderId) showHeader = false;
            lastSenderId = senderId;
            messageDiv.innerHTML = `
                ${showHeader ? `<div class=\"message-avatar\"><i class=\"fas ${avatarClass}\"></i></div>` : ''}
                <div class=\"message-content\">
                    <div class=\"message-header\">
                        ${showHeader ? `<span class=\"message-sender\" style=\"color:${roleColor}\">${senderName}</span><span class=\"message-role\">${senderRole}</span><span class=\"message-time\">${timeString}</span>` : ''}
                    </div>
                    <div class=\"message-text\">${message}</div>
                </div>
            `;
            messagesContainer.appendChild(messageDiv);
            scrollToBottom();
        }

        function scrollToBottom() {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        // Start connection
        connection.start().then(function() {
            console.log("SignalR Connected");
            scrollToBottom();
        }).catch(function(err) {
            console.error(err.toString());
        });

        // Scroll to bottom on page load
        window.addEventListener('load', scrollToBottom);

        // Marcar mensagens como lidas ao abrir a conversa
        document.addEventListener('DOMContentLoaded', function() {
            var unreadMessages = @Model.Messages.Count(m => m.SenderId != Model.CurrentUserId && !m.IsRead);
            if (unreadMessages > 0) {
                fetch('/Chat/MarkAsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ conversationId: @Model.ConversationId })
                })
                .then(res => res.json())
                .then(data => {
                    // Opcional: atualizar badge global, etc.
                });
            }
        });

        // Reload automático após enviar/receber mensagem
        function reloadChatAfterMessage() {
            setTimeout(function() {
                location.reload();
            }, 200); // pequeno delay para garantir que backend já marcou como lida
        }
        // Hook no envio de mensagem
        if (messageForm) {
            messageForm.addEventListener('submit', function() {
                reloadChatAfterMessage();
            });
        }
        // Hook no SignalR para reload ao receber mensagem
        if (window.connection) {
            window.connection.on("ReceiveMessage", function() {
                reloadChatAfterMessage();
            });
        }
    </script>
}