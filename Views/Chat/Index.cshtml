@model ImoSphere.Models.ChatViewModel
@{
    ViewData["Title"] = "Chat";
    string GetRoleLabel(string userId)
    {
        if (userId == Model.ComercialId && Model.IsAdmin)
            return "Admin";
        if (userId == Model.ComercialId)
            return "Comercial";
        return null;
    }
    string GetRoleColor(string role)
    {
        if (role == "Admin") return "#8be9fd";
        if (role == "Comercial") return "#bbb";
        return "#fff";
    }
}
@Html.AntiForgeryToken()
<div class="chat-page-container">
    <div class="chat-header d-flex align-items-center mb-3" style="gap:18px;">
        <a href="/Properties/Details/@Model.PropertyId" title="Ver detalhes da propriedade">
            <img src="@Model.PropertyImage" alt="Casa" class="chat-avatar" style="width:64px;height:64px;object-fit:cover;border-radius:12px;border:2px solid #333;box-shadow:0 2px 8px #0002;cursor:pointer;">
        </a>
        <div>
            <div class="d-flex align-items-center" style="gap:10px;">
                <h2 style="margin:0;font-size:1.4rem;font-weight:700;">@Model.PropertyName</h2>
                @if (!string.IsNullOrEmpty(Model.AgencyLogo))
                {
                    <img src="@Model.AgencyLogo" alt="Agência" style="height:32px;width:auto;max-width:60px;object-fit:contain;vertical-align:middle;" />
                }
            </div>
            <div style="font-size:1.05rem;color:#bbb;">
                <span>@ViewBag.OtherParticipantName</span>
            </div>
        </div>
    </div>
    <div class="chat-main-container">
        <div id="messagesList" class="messages-list" style="flex:1;overflow-y:auto;background:#181818;border-radius:10px;padding:18px 32px 12px 32px;margin-bottom:0;display:flex;flex-direction:column;justify-content:flex-end;min-height:200px;max-height:calc(100vh - 220px);width:100%;">
            @{
                string lastSenderId = null;
            }
            @for (int i = 0; i < Model.Messages.Count; i++)
            {
                var msg = Model.Messages[i];
                var isMine = msg.SenderId == Model.CurrentUserId;
                var role = Model.SenderRoles != null && Model.SenderRoles.ContainsKey(msg.SenderId) ? Model.SenderRoles[msg.SenderId] : null;
                bool showName = !isMine && (i == 0 || Model.Messages[i - 1].SenderId != msg.SenderId);
            <div style="display:flex;flex-direction:column;align-items:@(isMine ? "flex-end" : "flex-start");margin-bottom:2px;">
                @if (showName)
                {
                    <span style="font-size:0.93em;font-weight:600;color:@GetRoleColor(role);margin-bottom:1px;">
                        @msg.SenderName@((!string.IsNullOrEmpty(role) && role != "Cliente") ? $" ({role})" : (role == "Cliente" ? " (Cliente)" : ""))
                    </span>
                }
                <div class="chat-bubble @(isMine ? "mine" : "theirs")">
                    <div class="bubble-content">@msg.Text</div>
                    <div class="bubble-meta">@msg.SentAt.ToLocalTime().ToString("HH:mm")</div>
                </div>
            </div>
            }
        </div>
    </div>
    @if (Model.CanSend)
    {
        <form id="chatForm" class="d-flex gap-2 chat-input-form" style="align-items:center;background:#181818;padding:12px 0 0 0;z-index:10;position:sticky;bottom:0;width:100%;margin:0 auto;">
            <input type="hidden" id="conversationId" value="@Model.ConversationId" />
            <input type="text" id="messageInput" class="form-control" placeholder="Escreva a sua mensagem..." autocomplete="off" style="flex:1;" />
            <button type="submit" id="sendBtn" class="btn btn-primary">Enviar</button>
        </form>
    }
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        let signalRConnected = false;
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();
        connection.on("ReceiveMessage", (user, senderName, senderRole, message, sentAt) => {
            try {
                const messagesList = document.getElementById("messagesList");
                // Verifica se a última mensagem foi do mesmo sender
                let lastSender = null;
                if (messagesList.lastElementChild) {
                    lastSender = messagesList.lastElementChild.getAttribute("data-sender-id");
                }
                // Só mostrar nome/role se NÃO for o utilizador atual
                const showName = (user !== "@Model.CurrentUserId") && (!lastSender || lastSender !== user);
                const msgDiv = document.createElement("div");
                msgDiv.style.display = "flex";
                msgDiv.style.flexDirection = "column";
                msgDiv.style.alignItems = (user === "@Model.CurrentUserId") ? "flex-end" : "flex-start";
                msgDiv.style.marginBottom = "2px";
                msgDiv.setAttribute("data-sender-id", user);
                if (showName) {
                    const nameSpan = document.createElement("span");
                    nameSpan.style.fontSize = "0.93em";
                    nameSpan.style.fontWeight = "600";
                    nameSpan.style.marginBottom = "1px";
                    if (senderRole === "Admin") nameSpan.style.color = "#8be9fd";
                    else if (senderRole === "Comercial") nameSpan.style.color = "#bbb";
                    else nameSpan.style.color = "#fff";
                    nameSpan.textContent = senderName + (senderRole && senderRole !== "Cliente" ? ` (${senderRole})` : (senderRole === "Cliente" ? " (Cliente)" : ""));
                    msgDiv.appendChild(nameSpan);
                }
                const bubbleDiv = document.createElement("div");
                bubbleDiv.className = "chat-bubble " + (user === "@Model.CurrentUserId" ? "mine" : "theirs");
                bubbleDiv.innerHTML = `<div class='bubble-content'>${message}</div><div class='bubble-meta'>${sentAt}</div>`;
                msgDiv.appendChild(bubbleDiv);
                messagesList.appendChild(msgDiv);
                messagesList.scrollTop = messagesList.scrollHeight;
            } catch (e) {
                console.error("Erro ao processar mensagem SignalR:", e, arguments);
            }
        });
        connection.start().then(() => {
            signalRConnected = true;
            console.log("SignalR connected!");
            // Entrar no grupo da conversa
            const convId = document.getElementById("conversationId").value;
            connection.invoke("JoinConversation", convId).catch(err => console.error(err.toString()));
            // Ativar o botão de enviar
            document.getElementById("sendBtn")?.removeAttribute("disabled");
        }).catch(err => {
            console.error("Erro ao ligar SignalR:", err);
            signalRConnected = false;
        });
        const form = document.getElementById("chatForm");
        if (form) {
            form.addEventListener("submit", function (e) {
                e.preventDefault();
                if (!signalRConnected) {
                    alert("A ligação ao chat ainda não está pronta. Por favor, aguarde uns segundos e tente novamente.");
                    return;
                }
                const msg = document.getElementById("messageInput").value;
                const convId = document.getElementById("conversationId").value;
                if (msg.trim()) {
                    connection.invoke("SendMessage", convId, msg).catch(err => console.error(err.toString()));
                    document.getElementById("messageInput").value = "";
                }
            });
        }
        // Desativar o botão de enviar até o SignalR estar ligado
        document.getElementById("sendBtn")?.setAttribute("disabled", "disabled");
        // Scroll para o fim ao carregar
        setTimeout(() => {
            var list = document.getElementById("messagesList");
            list.scrollTop = list.scrollHeight;
        }, 200);
        
        // Marcar mensagens como lidas quando abrir a conversa
        const convIdInput = document.getElementById("conversationId");
        if (convIdInput) {
            const convId = convIdInput.value;
            fetch('/Chat/MarkAsRead', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ conversationId: convId })
            })
            .then(() => {
                // Esconde o badge do header
                const badge = document.getElementById("unreadBadge");
                if (badge) badge.style.display = "none";
                // Esconde o badge da conversa na lista, se existir
                const convBadge = document.querySelector(`.conversation-badge[data-conversation-id="${convId}"]`);
                if (convBadge) convBadge.style.display = "none";
            })
            .catch(err => console.error(err.toString()));
        }
    </script>
    <style>
        .chat-header { background: #181818; border-radius: 10px; padding: 18px 18px 10px 18px; margin-bottom: 18px; }
        .chat-avatar { box-shadow: 0 2px 8px #0002; }
        .chat-bubble { max-width: 70%; margin-bottom: 10px; padding: 10px 14px; border-radius: 16px; position: relative; font-size: 1.05rem; display: inline-block; }
        .chat-bubble.mine { background: var(--secondary-color); color: #fff; margin-left: auto; text-align: right; }
        .chat-bubble.theirs { background: #232323; color: #eee; margin-right: auto; text-align: left; }
        .bubble-content { margin-bottom: 2px; }
        .bubble-meta { font-size: 0.85em; color: #bbb; text-align: right; }
        .chat-container { min-height: 400px; width: 100%; }
        .chat-input-form { position: sticky; bottom: 0; background: #181818; width: 100%; }
        @@media (max-width: 600px) {
            .chat-header { padding: 10px 6px 6px 6px; }
            #messagesList { padding: 8px 2px 2px 2px; }
        }
    </style>
}