@{
    ViewData["Title"] = "Home";
    var badges = new[] { "<i class='fas fa-gem me-1'></i>Exclusiva", "<i class='fas fa-crown me-1'></i>Portugal Deluxe", "<i class='fas fa-eye me-1'></i>Vista Única", "<i class='fas fa-star me-1'></i>Premium", "<i class='fas fa-bolt me-1'></i>Oportunidade", "<i class='fas fa-diamond me-1'></i>Coleção Luxo", "<i class='fas fa-fire me-1'></i>Destaque" };
    var badgeRnd = new System.Random();
    Func<string, string> getAgencyLogo = (agencyName) => {
        if (string.IsNullOrWhiteSpace(agencyName)) return "/images/placeholder.png";
        var name = agencyName.ToLower().Replace(" ", "");
        if (name.Contains("era")) return "/images/era.png";
        if (name.Contains("remax")) return "/images/remax.png";
        if (name.Contains("kw")) return "/images/kw.png";
        if (name.Contains("century21")) return "/images/century21.png";
        if (name.Contains("fine")) return "/images/fine and country.png";
        return "/images/placeholder.png";
    };
}

<!-- HERO SECTION PREMIUM -->
<div class="hero-section premium-hero">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6 fade-in-up">
