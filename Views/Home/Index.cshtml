                        <img src="~/images/Selo.png" alt="Premium Badge" class="img-fluid" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-bg-animated"></div>
</div>

<!-- FEATURED PROPERTIES SLIDER -->
<section class="featured-properties py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">
                <i class="fas fa-star text-warning me-2"></i>Propriedades em Destaque
            </h2>
            <p class="lead text-muted">Descobre as nossas listagens mais populares e premium</p>
        </div>
        <div class="row g-4 justify-content-center">
            @if (ViewBag.FeaturedProperties != null)
            {
                foreach (var prop in (IEnumerable<ImoSphere.Models.Property>)ViewBag.FeaturedProperties)
                {
                    var badge = badges[badgeRnd.Next(badges.Length)];
                    var agencyLogo = getAgencyLogo(prop.Agency?.Name);
                    <div class="col-lg-4 col-md-6">
                        <div class="card featured-card h-100 hover-lift position-relative">
                            <div class="featured-badge-premium animated-badge">@Html.Raw(badge)</div>
                            <div class="property-image-container position-relative">
                                <img src="@(prop.Images?.FirstOrDefault()?.ImageUrl ?? "/images/placeholder.png")" alt="@prop.Name" class="card-img-top property-image" />
                                <div class="property-price-badge">
                                    <span class="badge bg-primary">@prop.Price.ToString("N0")€</span>
                                </div>
                                <div class="agency-logo-badge-bottom">
                                    <img src="@agencyLogo" alt="@prop.Agency?.Name" title="@prop.Agency?.Name" />
                                </div>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">@prop.Name</h5>
                                <p class="card-text text-muted">
                                    <i class="fas fa-map-marker-alt me-1"></i>@prop.Location
                                </p>
                                <div class="property-features">
                                    <div class="feature-item"><i class="fas fa-bed text-primary"></i><span>@prop.Bedrooms</span></div>
                                    <div class="feature-item"><i class="fas fa-bath text-primary"></i><span>@prop.Bathrooms</span></div>
                                    <div class="feature-item"><i class="fas fa-ruler-combined text-primary"></i><span>@prop.Area m²</span></div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <a href="/Properties/Details/@prop.Id" class="btn btn-primary w-100"><i class="fas fa-eye me-2"></i>Ver Detalhes</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="text-center mt-5">
            <a href="@Url.Action("Properties", "Home")" class="btn btn-outline-primary btn-lg">
                <i class="fas fa-search me-2"></i>Ver Todas as Propriedades
            </a>
        </div>
    </div>
</section>

