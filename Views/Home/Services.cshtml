                        <p class="mb-4">@Localizer["ReadyToStartSubtitle"]</p>
                        <a href="/Home/ContactUs" class="btn btn-outline-primary btn-lg me-3">
                            <i class="fas fa-phone me-2"></i>@Localizer["Contact"]
                        </a>
                        <a href="/Home/Properties" class="btn btn-outline-primary btn-lg">
