            <div class="row g-4">
                <div class="col-md-3">
                    <div class="stat-card glass-card rounded-4">
                        <div class="stat-number counter" data-target="1500">0</div>
                        <div class="stat-label">@Localizer["StatSoldProperties"]</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card glass-card rounded-4">
                        <div class="stat-number counter" data-target="500">0</div>
                        <div class="stat-label">@Localizer["StatHappyClients"]</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card glass-card rounded-4">
                        <div class="stat-number counter" data-target="25">0</div>
                        <div class="stat-label">@Localizer["StatYearsExperience"]</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card glass-card rounded-4">
                        <div class="stat-number counter" data-target="98">0</div>
                        <div class="stat-label">@Localizer["StatSatisfaction"]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

