        <div class="container">
            <h2 class="text-center mb-5">@Localizer["MainServicesTitle"]</h2>
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="service-card glass-card rounded-4">
                        <div class="service-icon">
                            <i class="fas fa-home fa-2x"></i>
                        </div>
                        <h4>@Localizer["ServiceBuySellTitle"]</h4>
                        <p>@Localizer["ServiceBuySellDesc"]</p>
                        <a href="#" class="btn btn-primary">@Localizer["LearnMore"]</a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="service-card glass-card rounded-4">
                        <div class="service-icon">
                            <i class="fas fa-key fa-2x"></i>
                        </div>
                        <h4>@Localizer["ServiceRentTitle"]</h4>
                        <p>@Localizer["ServiceRentDesc"]</p>
                        <a href="#" class="btn btn-primary">@Localizer["LearnMore"]</a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="service-card glass-card rounded-4">
                        <div class="service-icon">
                            <i class="fas fa-chart-line fa-2x"></i>
                        </div>
                        <h4>@Localizer["ServiceAppraisalTitle"]</h4>
                        <p>@Localizer["ServiceAppraisalDesc"]</p>
                        <a href="#" class="btn btn-primary">@Localizer["LearnMore"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="specialized-section py-5" style="background: none;">
        <div class="container">
            <h2 class="text-center mb-5">@Localizer["SpecializedServicesTitle"]</h2>
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="specialized-service-card glass-card rounded-4">
                        <div class="service-icon-small">
                            <i class="fas fa-building fa-1x"></i>
