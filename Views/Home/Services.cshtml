                        <span class="service-tag">@Localizer["Specialized"]</span>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="specialized-service-card glass-card rounded-4">
                        <div class="service-icon-small">
                            <i class="fas fa-umbrella-beach fa-1x"></i>
                        </div>
                        <h4>@Localizer["ServiceLuxuryTitle"]</h4>
                        <p>@Localizer["ServiceLuxuryDesc"]</p>
                        <span class="service-tag">@Localizer["Premium"]</span>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="specialized-service-card glass-card rounded-4">
                        <div class="service-icon-small">
                            <i class="fas fa-hammer fa-1x"></i>
                        </div>
                        <h4>@Localizer["ServiceInvestmentTitle"]</h4>
                        <p>@Localizer["ServiceInvestmentDesc"]</p>
                        <span class="service-tag">@Localizer["Investment"]</span>
