                            <div class="author-info">
                                <h6>João Santos</h6>
                                <div class="rating">
                                    <i class="fas fa-star text-warning"></i>
                                    <i class="fas fa-star text-warning"></i>
                                    <i class="fas fa-star text-warning"></i>
                                    <i class="fas fa-star text-warning"></i>
                                    <i class="fas fa-star text-warning"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="testimonial-card glass-card rounded-4">
                        <div class="testimonial-content">
                            <p>@Localizer["Testimonial3"]</p>
                        </div>
                        <div class="testimonial-author">
                            <div class="author-avatar rounded-pill">
                                <i class="fas fa-user-circle fa-2x"></i>
                            </div>
                            <div class="author-info">
                                <h6>Ana Costa</h6>
                                <div class="rating">
                                    <i class="fas fa-star text-warning"></i>
