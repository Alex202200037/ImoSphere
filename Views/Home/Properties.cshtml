@model IEnumerable<ImoSphere.Models.Property>
@using System.Linq
@{
    ViewData["Title"] = "Properties";
    var isAuthenticated = User.Identity.IsAuthenticated;
}

<h1 class="text-center">Our Properties</h1>
<p style="text-align: center;">
    Explore the wide variety of properties available with ImoSphere. Find your dream home today!
</p>

@if ((ViewBag.UserRole as string) == "Admin" || (ViewBag.UserRole as string) == "Comercial")
{
    <div class="text-center mb-3">
        <a href="@Url.Action("Create", "Properties")" class="btn btn-success">➕ &nbsp; Add New Property</a>
    </div>
}

<div class="property-list">
@foreach (var property in Model)
{
    <div class="property-item">
        <div style="position: relative; display: inline-block;">
            @if (property.Images != null && property.Images.Any())
            {
                <img src="@Url.Content(property.Images.First().ImageUrl)" alt="@property.Name" class="property-image" style="max-height:200px;object-fit:cover;" />
            }
            else
            {
                <img src="@Url.Content("/images/placeholder.png")" alt="No image" class="property-image" style="max-height:200px;object-fit:cover;" />
            }
            <div style="position: absolute; top: 8px; right: 8px; background: rgba(255,255,255,0.8); border-radius: 6px; padding: 2px 8px;">
                @{
                    var agencyName = property.Agency?.Name ?? "";
                    var logoFile = $"/images/{agencyName.ToLower()}.png";
                }
                <img src="@Url.Content(logoFile)" alt="@agencyName Logo" style="height: 32px; max-width: 60px; object-fit: contain;" onerror="this.style.display='none';this.parentElement.innerHTML='@agencyName';" />
            </div>
            <span style="position:absolute;top:0;left:0;background:rgba(0,0,0,0.5);color:#fff;font-size:12px;z-index:2;">Imgs: @(property.Images != null ? property.Images.Count().ToString() : "null")</span>
        </div>
        <h2>@property.Name</h2>
        <ul class="property-home-features">
            <li>@property.Bedrooms Bedrooms</li>
            <li>@property.Bathrooms Bathrooms</li>
            <li>@property.Area sq ft</li>
            <li>@property.Location</li>
            <li>Built in @property.YearBuilt</li>
        </ul>
        <p>@property.Description</p>

        <div>
            <p id="price"><strong>Price:</strong> @property.Price.ToString("C")</p>
            <div class="button-group d-flex justify-content-center gap-2">
                @if (isAuthenticated)
                {
                    <a href="@Url.Action("Details", "Properties", new { id = property.Id })" class="btn btn-primary">Details</a>

                    if (((ViewBag.UserRole as string) == "Admin" || (ViewBag.UserRole as string) == "Comercial") && (ViewBag.UserAgency as string) == (property.Agency?.Name as string))
                    {
                        <a href="@Url.Action("Edit", "Properties", new { id = property.Id })" class="btn btn-primary">Edit</a>
                    }

                    @if (ViewBag.UserRole == "Admin")
                    {
                        <form asp-action="Delete" asp-controller="Properties" method="post" class="d-inline-block"
                              onsubmit="return confirm('Are you sure you want to delete this property?');">
                            <input type="hidden" name="id" value="@property.Id" />
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    }
                }
                else
                {
                    <a href="@Url.Action("Details", "Properties", new { id = property.Id })" class="btn btn-primary">View Details</a>
                }
            </div>
        </div>
    </div>
}
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="popup-overlay" id="popupOverlay" style="display: none;">
        <div class="popup-content">
            <div class="spinner"></div>
            <p>@TempData["SuccessMessage"]</p>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const popup = document.getElementById('popupOverlay');

            if (popup) {
                popup.style.display = 'flex';
                popup.style.justifyContent = 'center';
                popup.style.alignItems = 'center';

                popup.style.opacity = 0;
                popup.style.transition = "opacity 0.5s ease-in-out";
                setTimeout(() => popup.style.opacity = 1, 100);

                setTimeout(() => {
                    popup.style.opacity = 0;
                    setTimeout(() => popup.style.display = 'none', 500);
                }, 1500);
            }
        });
    </script>
}
