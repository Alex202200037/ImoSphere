@model ImoSphere.Models.PropertyFilterViewModel
@using System.Linq
@{
    ViewData["Title"] = "Properties";
    var isAuthenticated = User.Identity.IsAuthenticated;
    var userRole = ViewBag.UserRole as string;
    var userAgency = ViewBag.UserAgency as string;
    var userId = ViewBag.UserId as string;
}

<div class="properties-container">
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar de Filtros -->
            <div class="col-lg-3 col-md-4">
                <div class="card filter-sidebar sticky-top" style="top: 20px;">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-filter me-2"></i>Filtros Avançados
                        </h5>
                    </div>
                    <div class="card-body">
                        <form method="get" id="filterForm">
                            @if (Model.ShowMap)
                            {
                                <input type="hidden" name="showMap" value="true" />
                            }
                            
                            <!-- Preço -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-euro-sign me-1"></i>Preço (€)
                                </label>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <input type="number" class="form-control" name="minPrice" placeholder="Min" value="@Model.MinPrice" />
                                    </div>
                                    <div class="col-6">
                                        <input type="number" class="form-control" name="maxPrice" placeholder="Max" value="@Model.MaxPrice" />
                                    </div>
                                </div>
                            </div>

                            <!-- WC's -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-bath me-1"></i>Nº de WC's
                                </label>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <input type="number" class="form-control" name="minBathrooms" placeholder="Min" value="@Model.MinBathrooms" />
                                    </div>
                                    <div class="col-6">
                                        <input type="number" class="form-control" name="maxBathrooms" placeholder="Max" value="@Model.MaxBathrooms" />
                                    </div>
                                </div>
                            </div>

                            <!-- Quartos -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-bed me-1"></i>Nº de Quartos
                                </label>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <input type="number" class="form-control" name="minBedrooms" placeholder="Min" value="@Model.MinBedrooms" />
                                    </div>
                                    <div class="col-6">
                                        <input type="number" class="form-control" name="maxBedrooms" placeholder="Max" value="@Model.MaxBedrooms" />
                                    </div>
                                </div>
                            </div>

                            <!-- Área -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-ruler-combined me-1"></i>Área (m²)
                                </label>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <input type="number" class="form-control" name="minArea" placeholder="Min" value="@Model.MinArea" />
                                    </div>
                                    <div class="col-6">
                                        <input type="number" class="form-control" name="maxArea" placeholder="Max" value="@Model.MaxArea" />
                                    </div>
                                </div>
                            </div>

                            <!-- Ano de Construção -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-calendar-alt me-1"></i>Ano de Construção
                                </label>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <input type="number" class="form-control" name="minYearBuilt" placeholder="Min" value="@Model.MinYearBuilt" />
                                    </div>
                                    <div class="col-6">
                                        <input type="number" class="form-control" name="maxYearBuilt" placeholder="Max" value="@Model.MaxYearBuilt" />
                                    </div>
                                </div>
                            </div>

                            <!-- Localização -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-map-marker-alt me-1"></i>Localização
                                </label>
                                <input type="text" class="form-control" name="location" placeholder="Ex: Lisboa, Porto..." value="@Model.Location" />
                            </div>

                            <!-- Agências -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-building me-1"></i>Agências
                                </label>
                                <div class="agency-filters">
                                    @foreach (var agency in Model.AvailableAgencies)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="agencyIds" value="@agency.Id" 
                                                   @(Model.AgencyIds.Contains(agency.Id) ? "checked" : "") />
                                            <label class="form-check-label">@agency.Name</label>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Ordenação -->
                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="fas fa-sort me-1"></i>Ordenar por
                                </label>
                                <select class="form-select" name="sortBy">
                                    <option value="Name" selected="@(Model.SortBy == "Name")">Nome</option>
                                    <option value="Price" selected="@(Model.SortBy == "Price")">Preço</option>
                                    <option value="Area" selected="@(Model.SortBy == "Area")">Área</option>
                                    <option value="Bedrooms" selected="@(Model.SortBy == "Bedrooms")">Quartos</option>
                                    <option value="Bathrooms" selected="@(Model.SortBy == "Bathrooms")">WC's</option>
                                    <option value="YearBuilt" selected="@(Model.SortBy == "YearBuilt")">Ano</option>
                                </select>
                            </div>

                            <div class="mb-4">
                                <label class="form-label">
                                    <i class="fas fa-sort-amount-down me-1"></i>Ordem
                                </label>
                                <select class="form-select" name="sortOrder">
                                    <option value="asc" selected="@(Model.SortOrder == "asc")">Crescente</option>
                                    <option value="desc" selected="@(Model.SortOrder == "desc")">Decrescente</option>
                                </select>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search me-2"></i>Aplicar Filtros
                                </button>
                                <a href="@Url.Action("Properties", "Home")" class="btn btn-clear-filters">
                                    <i class="fas fa-undo me-2"></i>Limpar Filtros
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Conteúdo Principal -->
            <div class="col-lg-9 col-md-8">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h1 class="mb-1">
                            <i class="fas fa-home me-2"></i>Nossas Propriedades
                        </h1>
                        <p class="text-muted mb-0">Encontre a propriedade dos seus sonhos</p>
                    </div>
                    <div>
                        @if (userRole == "Admin" || userRole == "Comercial" || userRole == "SuperAdmin")
                        {
                            <a href="@Url.Action("Create", "Properties")" class="btn btn-success">
                                <i class="fas fa-plus me-2"></i>Adicionar Propriedade
                            </a>
                        }
                    </div>
                </div>

                <!-- Toggle Map/List -->
                <div class="mb-4">
                    <div class="btn-group" role="group">
                        <a href="@Url.Action("Properties", "Home", new { showMap = false })" 
                           class="btn @(!Model.ShowMap ? "btn-primary" : "btn-outline-primary")">
                            <i class="fas fa-th-large me-2"></i>Lista
                        </a>
                        <a href="@Url.Action("Properties", "Home", new { showMap = true })" 
                           class="btn @(Model.ShowMap ? "btn-primary" : "btn-outline-primary")">
                            <i class="fas fa-map me-2"></i>Mapa
                        </a>
                    </div>
                </div>

                @if (Model.ShowMap)
                {
                    <!-- Mapa -->
                    <div class="card map-card">
                        <div class="card-body p-0">
                            <div id="map" class="property-map"></div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Lista de Propriedades -->
                    <div class="row g-4">
                        @foreach (var property in Model.Properties)
                        {
                            <div class="col-xl-4 col-lg-6 col-md-6">
                                <div class="card property-card h-100 hover-lift">
                                    <div class="property-image-container position-relative">
                                        @if (property.Images != null && property.Images.Any())
                                        {
                                            <img src="@property.Images.First().ImageUrl" class="card-img-top property-image" alt="@property.Name" />
                                        }
                                        else
                                        {
                                            <div class="property-image-placeholder">
                                                <i class="fas fa-home fa-3x text-muted"></i>
                                            </div>
                                        }
                                        <div class="agency-logo-badge" style="position: absolute; top: 10px; left: 10px; z-index: 11;">
                                            <img src="@GetAgencyLogo(property.Agency?.Name)" alt="@property.Agency?.Name" class="agency-logo" title="@property.Agency?.Name" />
                                        </div>
                                        <div class="property-price-badge" style="position: absolute; top: 10px; right: 10px; z-index: 12;">
                                            <span class="badge bg-primary">€@property.Price.ToString("N0")</span>
                                        </div>
                                    </div>
                                    
                                    <div class="card-body">
                                        <h5 class="card-title">@property.Name</h5>
                                        <p class="card-text text-muted">
                                            <i class="fas fa-map-marker-alt me-1"></i>@property.Location
                                        </p>
                                        
                                        <div class="property-features">
                                            <div class="feature-item">
                                                <i class="fas fa-bed text-primary"></i>
                                                <span>@property.Bedrooms</span>
                                            </div>
                                            <div class="feature-item">
                                                <i class="fas fa-bath text-primary"></i>
                                                <span>@property.Bathrooms</span>
                                            </div>
                                            <div class="feature-item">
                                                <i class="fas fa-ruler-combined text-primary"></i>
                                                <span>@property.Area m²</span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="card-footer">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="agency-info">
                                                <small class="text-muted">
                                                    <i class="fas fa-building me-1"></i>@property.Agency?.Name
                                                </small>
                                            </div>
                                            <a href="@Url.Action("Details", "Properties", new { id = property.Id })" class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-eye me-1"></i>Ver Detalhes
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetAgencyLogo(string agencyName)
    {
        var name = agencyName?.ToLower().Replace(" ", "");
        return name switch
        {
            "remax" => "/images/remax.png",
            "era" => "/images/era.png",
            "century21" => "/images/century21.png",
            "fineandcountry" => "/images/fine and country.png",
            "kw" => "/images/kw.png",
            _ => "/images/remax.png" // Default logo
        };
    }
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="popup-overlay" id="popupOverlay" style="display: none;">
        <div class="popup-content">
            <div class="spinner"></div>
            <p>@TempData["SuccessMessage"]</p>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Popup de sucesso
            const popup = document.getElementById('popupOverlay');
            if (popup) {
                popup.style.display = 'flex';
                popup.style.justifyContent = 'center';
                popup.style.alignItems = 'center';
                popup.style.opacity = 0;
                popup.style.transition = "opacity 0.5s ease-in-out";
                setTimeout(() => popup.style.opacity = 1, 100);
                setTimeout(() => {
                    popup.style.opacity = 0;
                    setTimeout(() => popup.style.display = 'none', 500);
                }, 1500);
            }

            // Melhorar UX dos filtros
            const filterForm = document.getElementById('filterForm');
            const inputs = filterForm.querySelectorAll('input, select');
            
            // Auto-submit quando alterar ordenação
            const sortSelects = filterForm.querySelectorAll('select[name="sortBy"], select[name="sortOrder"]');
            sortSelects.forEach(select => {
                select.addEventListener('change', () => {
                    filterForm.submit();
                });
            });

            // Debounce para inputs de texto (localização)
            let timeout;
            const locationInput = filterForm.querySelector('input[name="location"]');
            if (locationInput) {
                locationInput.addEventListener('input', () => {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => {
                        filterForm.submit();
                    }, 1000); // 1 segundo de delay
                });
            }

            // Feedback visual para checkboxes de agências
            const agencyCheckboxes = filterForm.querySelectorAll('input[name="agencyIds"]');
            agencyCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', () => {
                    // Adicionar classe visual
                    const label = checkbox.nextElementSibling;
                    if (checkbox.checked) {
                        label.style.color = 'var(--secondary-color)';
                        label.style.fontWeight = 'bold';
                    } else {
                        label.style.color = 'var(--primary-color)';
                        label.style.fontWeight = 'normal';
                    }
                });
            });

            // Mostrar loading ao submeter filtros
            filterForm.addEventListener('submit', () => {
                const submitBtn = filterForm.querySelector('button[type="submit"]');
                submitBtn.innerHTML = '⏳ Aplicando...';
                submitBtn.disabled = true;
            });
        });
    </script>
}
