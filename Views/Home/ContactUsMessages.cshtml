@model IEnumerable<ImoSphere.Models.Message>
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["ContactMessagesTitle"];
    var messages = Model ?? Enumerable.Empty<ImoSphere.Models.Message>();
}
<div class="container py-5">
    <h1 class="text-center mb-4" style="color:#fff;">@Localizer["ContactMessagesTitle"]</h1>
    @if (!messages.Any())
    {
        <div class="alert alert-info text-center">@Localizer["NoMessagesYet"]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-striped align-middle rounded-4 overflow-hidden shadow-lg">
                <thead>
                    <tr>
                        <th>@Localizer["Name"]</th>
                        <th>@Localizer["Email"]</th>
                        <th>@Localizer["Message"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var message in messages)
                    {
                        <tr>
                            <td>@message.Name</td>
                            <td>@message.Email</td>
                            <td style="max-width:350px;white-space:pre-line;">@message.Content</td>
                            <td>
                                @if (message.IsRead)
                                {
                                    <span class="badge bg-success">@Localizer["Read"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@Localizer["Unread"]</span>
                                }
                            </td>
                            <td>
                                @if (!message.IsRead)
                                {
                                    <a asp-action="MarkAsRead" asp-route-id="@message.Id" class="btn btn-primary btn-sm">@Localizer["MarkAsRead"]</a>
                                }
                                <a asp-action="DeleteMessage" asp-route-id="@message.Id" class="btn btn-danger btn-sm"
                                    onclick="return confirm('@Localizer["ConfirmDeleteMessage"]');">@Localizer["Delete"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<style>
.table-dark th, .table-dark td { color: #fff; }
.table-dark { background: #23202b; }
</style> 