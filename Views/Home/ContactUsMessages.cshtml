@model IEnumerable<ImoSphere.Models.Message>
@{
    ViewData["Title"] = "Mensagens de Contacto";
    var messages = Model ?? Enumerable.Empty<ImoSphere.Models.Message>();
}
<div class="container py-5">
    <h1 class="text-center mb-4" style="color:#fff;">Mensagens de Contacto</h1>
    @if (!messages.Any())
    {
        <div class="alert alert-info text-center">Ainda não foram recebidas mensagens.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-striped align-middle rounded-4 overflow-hidden shadow-lg">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Mensagem</th>
                        <th>Estado</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var message in messages)
                    {
                        <tr>
                            <td>@message.Name</td>
                            <td>@message.Email</td>
                            <td style="max-width:350px;white-space:pre-line;">@message.Content</td>
                            <td>
                                @if (message.IsRead)
                                {
                                    <span class="badge bg-success">Lida</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Por ler</span>
                                }
                            </td>
                            <td>
                                @if (!message.IsRead)
                                {
                                    <a asp-action="MarkAsRead" asp-route-id="@message.Id" class="btn btn-primary btn-sm">Marcar como lida</a>
                                }
                                <a asp-action="DeleteMessage" asp-route-id="@message.Id" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Tem a certeza que deseja apagar esta mensagem?');">Apagar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<style>
.table-dark th, .table-dark td { color: #fff; }
.table-dark { background: #23202b; }
</style> 