@model ImoSphere.Models.ApplicationUser
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["UserProfileTitle"];
    var favorites = ViewBag.Favorites as List<ImoSphere.Models.Favorite> ?? new List<ImoSphere.Models.Favorite>();
    var favoritesCount = ViewBag.FavoritesCount ?? 0;
}

<link rel="stylesheet" href="~/css/perfil-user.css" asp-append-version="true" />

<!-- Profile Hero Section -->
<section class="profile-hero py-5">
    <div class="container">
        <div class="profile-header">
            <div class="row align-items-center">
                <div class="col-lg-3 text-center">
                    <div class="profile-avatar">
                        <i class="fas fa-user fa-4x"></i>
                    </div>
                    <div class="profile-badge">
                        <span class="badge bg-primary">Cliente</span>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="profile-info">
                        <h1 class="profile-name">@Model.UserName</h1>
                        <p class="profile-email">@Model.Email</p>
                        <div class="member-since">
                            <i class="fas fa-calendar-alt me-2"></i>
                            <span>Membro desde @DateTime.Now.ToString("MMMM yyyy")</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 text-end">
                    <div class="profile-actions">
                        <a href="@Url.Action("Properties", "Home")" class="btn btn-primary">
                            <i class="fas fa-home me-2"></i>Ver Propriedades
                        </a>
                        <a href="@Url.Action("GetFavorites", "Favorite")" class="btn btn-outline-primary mt-2">
                            <i class="fas fa-heart me-2"></i>Meus Favoritos
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Statistics Dashboard -->
<section class="stats-dashboard py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-heart"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number">@favoritesCount</h3>
                        <p class="stat-label">Favoritos</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number">@(favorites.Count(f => f.Property != null))</h3>
                        <p class="stat-label">Propriedades Visualizadas</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number">@DateTime.Now.ToString("MMM")</h3>
                        <p class="stat-label">Mês Ativo</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Content -->
<section class="favorites-section py-5">
    <div class="container">
        <ul class="nav nav-tabs" id="userTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-favoritos" data-bs-toggle="tab" data-bs-target="#tabFavoritos"
                    type="button" role="tab">
                    <i class="fas fa-heart me-2"></i>Meus Favoritos
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-activity" data-bs-toggle="tab" data-bs-target="#tabActivity"
                    type="button" role="tab">
                    <i class="fas fa-chart-line me-2"></i>Atividade
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-settings" data-bs-toggle="tab" data-bs-target="#tabSettings"
                    type="button" role="tab">
                    <i class="fas fa-cog me-2"></i>Definições
                </button>
            </li>
        </ul>

        <div class="tab-content" id="userTabsContent">
            <!-- Tab Favoritos -->
            <div class="tab-pane fade show active" id="tabFavoritos" role="tabpanel">
                <div class="section-header mb-5">
                    <h2 class="section-title">
                        <i class="fas fa-heart me-2"></i>Meus Favoritos
                    </h2>
                    <p class="section-subtitle">Propriedades que guardou para ver mais tarde</p>
                </div>

                @if (favorites.Any())
                {
                    <div class="row g-4">
                        @foreach (var favorite in favorites)
                        {
                            if (favorite.Property != null)
                            {
                                <div class="col-lg-4 col-md-4 col-sm-12">
                                    <div class="favorite-card position-relative">
                                        <div class="favorite-badge position-absolute" style="top: 10px; left: 18px; z-index: 3;">
                                            <span class="badge bg-warning">Favorito</span>
                                        </div>
                                        <div class="favorite-image">
                                            @if (favorite.Property.Images != null && favorite.Property.Images.Any())
                                            {
                                                <img src="@favorite.Property.Images.First().ImageUrl" alt="@favorite.Property.Name" />
                                            }
                                            else
                                            {
                                                <img src="/images/house-casas-1.png" alt="@favorite.Property.Name" />
                                            }
                                            <div class="favorite-overlay">
                                                <button class="btn btn-light favorite-toggle"
                                                    data-property-id="@favorite.PropertyId" title="Remover dos favoritos"
                                                    style="width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px #8f7cff33; position: absolute; top: 10px; right: 10px; z-index: 2;">
                                                    <i class="fas fa-heart text-danger" style="font-size: 1.3rem;"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="favorite-content">
                                            <div class="favorite-header">
                                                <h5 class="favorite-title">@favorite.Property.Name</h5>
                                                <p class="favorite-location">
                                                    <i class="fas fa-map-marker-alt me-1"></i>@favorite.Property.Location
                                                </p>
                                            </div>
                                            <div class="favorite-details">
                                                <div class="detail-item">
                                                    <span class="detail-icon">🛏️</span>
                                                    <span class="detail-text">@favorite.Property.Bedrooms</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="detail-icon">🛁</span>
                                                    <span class="detail-text">@favorite.Property.Bathrooms</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="detail-icon">📐</span>
                                                    <span class="detail-text">@favorite.Property.Area m²</span>
                                                </div>
                                            </div>
                                            <div class="favorite-price">
                                                <span class="price-amount">@favorite.Property.Price.ToString("C",
                                                                                            System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))</span>
                                </div>
                                <div class="favorite-actions">
                                    <a href="@Url.Action("Details", "Properties", new { id = favorite.Property.Id })"
                                        class="btn btn-primary btn-sm">
                                        <i class="fas fa-eye me-1"></i>Ver Detalhes
                                    </a>
                                    <span class="favorite-date">
                                        <i class="fas fa-calendar me-1"></i>@favorite.CreatedAt.ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                                        }
                        }
                    </div>
                }
                else
                {
                    <div class="empty-favorites">
                        <div class="empty-state text-center">
                            <i class="fas fa-heart fa-4x mb-3"></i>
                            <h4>Ainda não tem favoritos</h4>
                            <p class="text-muted">Explore as propriedades e adicione as que mais gostar aos seus favoritos!
                            </p>
                            <a href="@Url.Action("Properties", "Home")" class="btn btn-primary">
                                <i class="fas fa-search me-2"></i>Explorar Propriedades
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- Tab Atividade -->
            <div class="tab-pane fade" id="tabActivity" role="tabpanel">
                <section class="activity-section py-5">
                    <div class="section-header mb-5">
                        <h2 class="section-title">
                            <i class="fas fa-chart-line me-2"></i>Atividade Recente
                        </h2>
                        <p class="section-subtitle">As suas últimas ações no ImoSphere</p>
                    </div>

                    <div class="activity-timeline">
                        @if (favorites.Any())
                        {
                            @foreach (var favorite in favorites.Take(10))
                            {
                                <div class="activity-item">
                                    <div class="activity-icon">
                                        <i class="fas fa-heart"></i>
                                    </div>
                                    <div class="activity-content">
                                        <h6>Adicionou aos favoritos</h6>
                                        <p>@favorite.Property?.Name</p>
                                        <small class="text-muted">@favorite.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-activity text-center">
                                <i class="fas fa-chart-line fa-4x mb-3"></i>
                                <h4>Nenhuma atividade recente</h4>
                                <p class="text-muted">Comece a explorar propriedades para ver a sua atividade aqui!</p>
                            </div>
                        }
                    </div>
                </section>
            </div>

            <!-- Tab Definições -->
            <div class="tab-pane fade" id="tabSettings" role="tabpanel">
                <section class="settings-section py-5">
                    <div class="section-header mb-5">
                        <h2 class="section-title">
                            <i class="fas fa-cog me-2"></i>Definições da Conta
                        </h2>
                        <p class="section-subtitle">Gerir as suas preferências</p>
                    </div>

                    <div class="row">
                        <div class="col-lg-8">
                            <div class="settings-card">
                                <h5><i class="fas fa-user me-2"></i>Informações Pessoais</h5>
                                <div class="settings-form">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label>Nome de Utilizador</label>
                                            <input type="text" class="form-control" value="@Model.UserName" readonly />
                                        </div>
                                        <div class="col-md-6">
                                            <label>Email</label>
                                            <input type="email" class="form-control" value="@Model.Email" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="settings-card mt-4">
                                <h5><i class="fas fa-bell me-2"></i>Notificações</h5>
                                <div class="settings-options">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="emailNotifications" checked>
                                        <label class="form-check-label" for="emailNotifications">
                                            Receber notificações por email
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="newProperties" checked>
                                        <label class="form-check-label" for="newProperties">
                                            Notificar sobre novas propriedades
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="priceChanges">
                                        <label class="form-check-label" for="priceChanges">
                                            Alterações de preço nos favoritos
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="quick-actions">
                                <h5><i class="fas fa-bolt me-2"></i>Ações Rápidas</h5>
                                <div class="action-buttons">
                                    <a href="@Url.Action("Properties", "Home")" class="btn btn-primary w-100 mb-2">
                                        <i class="fas fa-search me-2"></i>Explorar Propriedades
                                    </a>
                                    <a href="@Url.Action("ContactUs", "Home")"
                                        class="btn btn-outline-primary w-100 mb-2">
                                        <i class="fas fa-envelope me-2"></i>Contactar Suporte
                                    </a>
                                    <a href="@Url.Action("AboutUs", "Home")" class="btn btn-outline-secondary w-100">
                                        <i class="fas fa-info-circle me-2"></i>Sobre Nós
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</section>

<script>
    // Toggle favorito (igual ao das propriedades)
    document.addEventListener('DOMContentLoaded', function () {
        const toggleButtons = document.querySelectorAll('.favorite-toggle');
        toggleButtons.forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const propertyId = parseInt(this.getAttribute('data-property-id'), 10);
                const card = this.closest('.favorite-card');
                fetch('/Favorite/ToggleFavorite', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ propertyId })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success && !data.isFavorite) {
                            card.style.transition = 'opacity 0.3s, transform 0.3s';
                            card.style.opacity = '0';
                            card.style.transform = 'scale(0.95)';
                            setTimeout(() => {
                                card.remove();
                                // Atualizar contador
                                const statNumber = document.querySelector('.stat-card .stat-number');
                                if (statNumber) {
                                    const currentCount = parseInt(statNumber.textContent);
                                    statNumber.textContent = (currentCount - 1).toString();
                                }
                                // Forçar reflow do grid para corrigir alinhamento
                                const row = card.closest('.row');
                                if (row) {
                                    row.style.display = 'none';
                                    setTimeout(() => { row.style.display = ''; }, 10);
                                }
                            }, 300);
                        } else if (!data.success) {
                            alert('Erro ao remover favorito: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Erro:', error);
                        alert('Erro ao remover favorito');
                    });
            });
        });
    });
</script>