@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["ContactUsTitle"];
}

<link rel="stylesheet" href="~/css/contact-us.css" asp-append-version="true" />

<section class="glass-section py-5">
    <div class="container">
        <h1>@Localizer["ContactUsTitle"]</h1>
        <p>@Localizer["ContactUsDescription"]</p>
    </div>

    <div class="contact-info-section py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="contact-info-card glass-card">
                        <div class="contact-icon">
                            <i class="fas fa-phone fa-2x"></i>
                        </div>
                        <h4>@Localizer["Phone"]</h4>
                        <p>+351 123 456 789</p>
                        <p>@Localizer["PhoneHours"]</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="contact-info-card glass-card">
                        <div class="contact-icon">
                            <i class="fas fa-envelope fa-2x"></i>
                        </div>
                        <h4>@Localizer["Email"]</h4>
                        <p>info@imosphere.pt</p>
                        <p>@Localizer["EmailResponse"]</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="contact-info-card glass-card">
                        <div class="contact-icon">
                            <i class="fas fa-map-marker-alt fa-2x"></i>
                        </div>
                        <h4>@Localizer["Office"]</h4>
                        <p>@Localizer["OfficeAddress"]</p>
                        <p>@Localizer["OfficeCity"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="contact-form-section py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-7">
                    <div class="contact-form-card glass-card p-4 shadow-lg rounded-4" style="background: #23202b;">
                        <h2 class="text-center mb-4" style="color: #fff;">@Localizer["SendMessageTitle"]</h2>
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
                        }
                        <form asp-action="SubmitContactForm" method="post" autocomplete="off">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-light">@Localizer["FullName"]</label>
                                    <input type="text" name="Name"
                                        class="form-control bg-dark text-light rounded-3 border-0" required
                                        placeholder="@Localizer["FullNamePlaceholder"]" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-light">@Localizer["Email"]</label>
                                    <input type="email" name="Email"
                                        class="form-control bg-dark text-light rounded-3 border-0" required
                                        placeholder="@Localizer["EmailPlaceholder"]" />
                                </div>
                            </div>
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <label class="form-label text-light">@Localizer["Subject"]</label>
                                    <select name="Subject" class="form-select bg-dark text-light rounded-3 border-0"
                                        required>
                                        <option value="">@Localizer["SelectSubject"]</option>
                                        <option>@Localizer["PropertyInfo"]</option>
                                        <option>@Localizer["ScheduleVisit"]</option>
                                        <option>@Localizer["TechnicalSupport"]</option>
                                        <option>@Localizer["Other"]</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-light">@Localizer["Phone"] <span
                                            style="color:#aaa;font-size:0.95em;">(@Localizer["Optional"])</span></label>
                                    <input type="tel" name="Telefone"
                                        class="form-control bg-dark text-light rounded-3 border-0"
                                        placeholder="@Localizer["PhonePlaceholder"]" autocomplete="off" />
                                </div>
                            </div>
                            <div class="form-group mt-3">
                                <label class="form-label text-light">@Localizer["Message"]</label>
                                <textarea name="Message" class="form-control bg-dark text-light rounded-3 border-0"
                                    rows="5" required placeholder="@Localizer["MessagePlaceholder"]"></textarea>
                            </div>
                            <div class="form-group mt-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="privacy" required />
                                    <label class="form-check-label text-light" for="privacy">
                                        @Localizer["PrivacyAccept"] <a href="/Home/Privacy"
                                            target="_blank">@Localizer["PrivacyPolicy"]</a>
                                    </label>
                                </div>
                            </div>
                            <div class="text-center mt-4">
                                <button type="submit" class="btn w-50 fw-bold"
                                    style="background: linear-gradient(90deg, #a259ff 0%, #5d26c1 100%); color: #fff; border: none;">@Localizer["SendMessage"]</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="faq-section py-5">
        <div class="container">
            <h2 class="text-center mb-5">@Localizer["FrequentlyAskedQuestions"]</h2>
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="accordion glass-card" id="faqAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faq1">
                                    @Localizer["FAQ1Question"]
                                </button>
                            </h2>
                            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                                <div class="accordion-body">
                                    @Localizer["FAQ1Answer"]
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faq2">
                                    @Localizer["FAQ2Question"]
                                </button>
                            </h2>
                            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body">
                                    @Localizer["FAQ2Answer"]
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#faq3">
                                    @Localizer["FAQ3Question"]
                                </button>
                            </h2>
                            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body">
                                    @Localizer["FAQ3Answer"]
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="social-section py-5">
        <div class="container">
            <h2 class="text-center mb-5">@Localizer["FollowUsOnSocialMedia"]</h2>
            <div class="social-links premium-social">
                <a href="#" class="social-link facebook">
                    <i class="fab fa-facebook-f"></i>
                    <span>Facebook</span>
                </a>
                <a href="#" class="social-link instagram">
                    <i class="fab fa-instagram"></i>
                    <span>Instagram</span>
                </a>
                <a href="#" class="social-link linkedin">
                    <i class="fab fa-linkedin-in"></i>
                    <span>LinkedIn</span>
                </a>
                <a href="#" class="social-link youtube">
                    <i class="fab fa-youtube"></i>
                    <span>YouTube</span>
                </a>
                <a href="#" class="social-link twitter">
                    <i class="fab fa-twitter"></i>
                    <span>Twitter</span>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-form-card {
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .form-control:focus,
    .form-select:focus {
        box-shadow: 0 0 0 2px #a259ff44;
        border-color: #a259ff;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Form validation and submission
        const contactForm = document.querySelector('.contact-form');

        contactForm.addEventListener('submit', function (e) {
            e.preventDefault();

            // Get form data
            const formData = new FormData(contactForm);

            // Show success message (in real app, this would submit to server)
            const submitBtn = contactForm.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;

            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Sending...';
            submitBtn.disabled = true;

            // Simulate form submission
            setTimeout(() => {
                submitBtn.innerHTML = '<i class="fas fa-check me-2"></i>Message Sent!';
                submitBtn.classList.remove('btn-primary');
                submitBtn.classList.add('btn-success');

                // Reset form
                contactForm.reset();

                // Reset button after 3 seconds
                setTimeout(() => {
                    submitBtn.innerHTML = originalText;
                    submitBtn.classList.remove('btn-success');
                    submitBtn.classList.add('btn-primary');
                    submitBtn.disabled = false;
                }, 3000);
            }, 2000);
        });

        // Phone number formatting
        const phoneInput = document.querySelector('input[type="tel"]');
        if (phoneInput) {
            phoneInput.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');
                if (value.length > 0) {
                    value = '+351 ' + value.replace(/(\d{3})(\d{3})(\d{3})/, '$1 $2 $3');
                }
                e.target.value = value;
            });
        }
    });
</script>
