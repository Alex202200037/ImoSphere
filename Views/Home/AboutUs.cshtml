@{
    ViewData["Title"] = "About Us";
}

<section class="glass-section py-5">
    <!-- Hero Section -->
    <section class="about-hero py-5" style="background: none;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 fade-in-up">
                    <h1 class="display-4 fw-bold mb-4">
                        About <span class="text-primary">ImoSphere</span>
                    </h1>
                    <p class="lead mb-4">
                        We are a leading real estate platform dedicated to transforming the way people discover, buy, and manage properties. With over 16 years of experience, we've helped thousands of families find their dream homes.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="@Url.Action("ContactUs", "Home")" class="btn btn-primary btn-lg">
                            <i class="fas fa-phone me-2"></i>Get in Touch
                        </a>
                        <a href="@Url.Action("Properties", "Home")" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-home me-2"></i>Browse Properties
                        </a>
                    </div>
                </div>
                <div class="col-lg-6 slide-in-right">
                    <div class="about-image-container rounded-4">
                        <img src="/images/Houses/moradia1.jpg" alt="Moradia ImoSphere" class="img-fluid rounded-4 shadow-heavy" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section py-5" style="background: none;">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold mb-3">
                    <i class="fas fa-chart-line text-success me-2"></i>Our Impact in Numbers
                </h2>
                <p class="lead text-muted">Real results that speak for themselves</p>
            </div>
            
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="stat-card glass-card text-center rounded-4">
                        <div class="stat-icon mb-3">
                            <i class="fas fa-home fa-2x text-primary"></i>
                        </div>
                        <h3 class="stat-number counter" data-target="10000">0</h3>
                        <p class="stat-label">Properties Listed</p>
                        <div class="stat-progress">
                            <div class="progress-bar" style="width: 100%"></div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6">
                    <div class="stat-card glass-card text-center rounded-4">
                        <div class="stat-icon mb-3">
                            <i class="fas fa-users fa-2x text-success"></i>
                        </div>
                        <h3 class="stat-number counter" data-target="2500">0</h3>
                        <p class="stat-label">Happy Customers</p>
                        <div class="stat-progress">
                            <div class="progress-bar" style="width: 95%"></div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6">
                    <div class="stat-card glass-card text-center rounded-4">
                        <div class="stat-icon mb-3">
                            <i class="fas fa-building fa-2x text-warning"></i>
                        </div>
                        <h3 class="stat-number counter" data-target="150">0</h3>
                        <p class="stat-label">Partner Agencies</p>
                        <div class="stat-progress">
                            <div class="progress-bar" style="width: 85%"></div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6">
                    <div class="stat-card glass-card text-center rounded-4">
                        <div class="stat-icon mb-3">
                            <i class="fas fa-award fa-2x text-danger"></i>
                        </div>
                        <h3 class="stat-number counter" data-target="16">0</h3>
                        <p class="stat-label">Years of Excellence</p>
                        <div class="stat-progress">
                            <div class="progress-bar" style="width: 100%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Our Story Section -->
    <section class="story-section py-5" style="background: none;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="story-image-container rounded-4">
                        <img src="/images/Houses/moradia3.jpg" alt="História ImoSphere" class="img-fluid rounded-4 shadow-heavy" />
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="story-content rounded-4">
                        <h2 class="display-5 fw-bold mb-4">
                            <i class="fas fa-history text-primary me-2"></i>Our Story
                        </h2>
                        <p class="lead mb-4">
                            Founded in 2008, ImoSphere began with a simple mission: to make real estate accessible, transparent, and enjoyable for everyone.
                        </p>
                        <p class="mb-4">
                            What started as a small local agency has grown into one of Portugal's most trusted real estate platforms. We've witnessed the evolution of the market and adapted our services to meet the changing needs of buyers, sellers, and investors.
                        </p>
                        <p class="mb-4">
                            Today, we're proud to serve thousands of satisfied customers across the country, helping them navigate the complex world of real estate with confidence and ease.
                        </p>
                        <div class="achievement-badges">
                            <span class="badge bg-primary me-2 mb-2 rounded-pill">
                                <i class="fas fa-star me-1"></i>Best Real Estate Platform 2023
                            </span>
                            <span class="badge bg-success me-2 mb-2 rounded-pill">
                                <i class="fas fa-certificate me-1"></i>ISO 9001 Certified
                            </span>
                            <span class="badge bg-warning me-2 mb-2 rounded-pill">
                                <i class="fas fa-trophy me-1"></i>Customer Choice Award
