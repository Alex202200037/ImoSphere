        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold mb-3">
                    <i class="fas fa-user-tie text-primary me-2"></i>Meet Our Leadership
                </h2>
                <p class="lead text-muted">The experts behind ImoSphere's success</p>
            </div>
            
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="team-card glass-card text-center rounded-4">
                        <div class="team-avatar mb-3">
                            <i class="fas fa-user-circle fa-4x text-primary"></i>
                        </div>
                        <h5 class="mb-1">Alexandre Miguel</h5>
                        <p class="text-muted mb-2">CEO & Founder</p>
                        <div class="team-social">
                            <a href="#"><i class="fab fa-linkedin"></i></a>
                            <a href="#"><i class="fab fa-twitter"></i></a>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4">
                    <div class="team-card glass-card text-center rounded-4">
                        <div class="team-avatar mb-3">
                            <i class="fas fa-user-circle fa-4x text-primary"></i>
                        </div>
                        <h5 class="mb-1">Maria Santos</h5>
                        <p class="text-muted mb-2">CTO</p>
                        <div class="team-social">
                            <a href="#"><i class="fab fa-linkedin"></i></a>
                            <a href="#"><i class="fab fa-twitter"></i></a>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4">
                    <div class="team-card glass-card text-center rounded-4">
                        <div class="team-avatar mb-3">
                            <i class="fas fa-user-circle fa-4x text-primary"></i>
                        </div>
                        <h5 class="mb-1">Pedro Costa</h5>
                        <p class="text-muted mb-2">Head of Sales</p>
                        <div class="team-social">
                            <a href="#"><i class="fab fa-linkedin"></i></a>
                            <a href="#"><i class="fab fa-twitter"></i></a>
                        </div>
                    </div>
                </div>
