    <!-- CTA Section -->
    <section class="cta-section py-5" style="background: none;">
        <div class="container">
            <div class="cta-card glass-card text-center rounded-4">
                <h2 class="display-5 fw-bold mb-4">
                    Ready to Find Your Dream Property?
                </h2>
                <p class="lead mb-4">
                    Join thousands of happy customers who have found their perfect home with ImoSphere.
                </p>
                <div class="d-flex gap-3 justify-content-center">
                    <a href="@Url.Action("Properties", "Home")" class="btn btn-primary btn-lg">
