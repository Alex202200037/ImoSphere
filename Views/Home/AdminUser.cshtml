@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["ManageUsersTitle"];
}

<h2>@Localizer["ManageUsersTitle"]</h2>
<p>@Localizer["ManageUsersDescription"]</p>

<table class="table">
    <thead>
        <tr>
            <th>@Localizer["Email"]</th>
            <th>@Localizer["Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>
                    <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-primary">@Localizer["Edit"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>