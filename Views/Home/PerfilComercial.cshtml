@model ImoSphere.Models.ApplicationUser
@{
    ViewData["Title"] = "Perfil Comercial";
    var casas = ViewBag.Casas as List<ImoSphere.Models.Property>;
    var agency = ViewBag.Agency as string;
    var logoFile = $"/images/{agency?.ToLower()}.png";
}

<link rel="stylesheet" href="~/css/perfil-comercial.css" asp-append-version="true" />

<!-- Profile Hero Section -->
<section class="profile-hero py-5">
    <div class="container">
        <div class="profile-header">
            <div class="row align-items-center">
                <div class="col-lg-3 text-center">
                    <div class="profile-avatar">
                        <i class="fas fa-user fa-4x"></i>
                    </div>
                    <div class="profile-badge">
                        <span class="badge bg-success">Comercial</span>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="profile-info">
                        <h1 class="profile-name">@Model.UserName</h1>
                        <p class="profile-email">@Model.Email</p>
                        <div class="agency-info">
                            <img src="@logoFile" alt="@agency Logo" class="agency-logo" />
                            <h4 class="agency-name">@agency</h4>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 text-end">
                    <div class="profile-actions">
                        <a href="@Url.Action("Properties", "Home", new { agency = agency })" class="btn btn-primary">
                            <i class="fas fa-home me-2"></i>Ver Propriedades
                        </a>
                        <a href="@Url.Action("Create", "Properties")" class="btn btn-success mt-2">
                            <i class="fas fa-plus me-2"></i>Adicionar Propriedade
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Statistics Dashboard -->
<section class="stats-dashboard py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-home fa-2x"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number">@(casas?.Count ?? 0)</h3>
                        <p class="stat-label">Minhas Propriedades</p>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-euro-sign fa-2x"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number">€@(casas?.Sum(c => c.Price).ToString("N0") ?? "0")</h3>
                        <p class="stat-label">Valor Total</p>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-chart-line fa-2x"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number">@(casas?.Average(c => c.Price).ToString("N0") ?? "0")</h3>
                        <p class="stat-label">Preço Médio</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- My Properties -->
<section class="my-properties py-5">
    <div class="container">
        <div class="section-header mb-5">
            <h2 class="section-title">
                <i class="fas fa-home me-2"></i>As Minhas Propriedades
            </h2>
            <p class="section-subtitle">Gerir as suas listagens de propriedades</p>
        </div>
        
        @if (casas != null && casas.Any())
        {
            <div class="row g-4">
                @foreach (var casa in casas)
                {
                    <div class="col-lg-6 col-xl-4">
                        <div class="property-card">
                            <div class="property-image">
                                @if (casa.Images != null && casa.Images.Any())
                                {
                                    <img src="@casa.Images.First().ImageUrl" alt="@casa.Name" class="property-img" />
                                }
                                else
                                {
                                    <div class="property-placeholder">
                                        <i class="fas fa-home fa-3x"></i>
                                    </div>
                                }
                                <div class="property-price-badge">
                                    <span class="price">€@casa.Price.ToString("N0")</span>
                                </div>
                            </div>
                            
                            <div class="property-content">
                                <h5 class="property-name">@casa.Name</h5>
                                <p class="property-location">
                                    <i class="fas fa-map-marker-alt me-1"></i>@casa.Location
                                </p>
                                
                                <div class="property-features">
                                    <span class="feature">
                                        <i class="fas fa-bed me-1"></i>@casa.Bedrooms
                                    </span>
                                    <span class="feature">
                                        <i class="fas fa-bath me-1"></i>@casa.Bathrooms
                                    </span>
                                    <span class="feature">
                                        <i class="fas fa-ruler-combined me-1"></i>@casa.Area m²
                                    </span>
                                </div>
                                
                                <div class="property-actions">
                                    <a href="@Url.Action("Edit", "Properties", new { id = casa.Id })" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-edit me-1"></i>Editar
                                    </a>
                                    <a href="@Url.Action("Details", "Properties", new { id = casa.Id })" class="btn btn-outline-info btn-sm">
                                        <i class="fas fa-eye me-1"></i>Ver
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-properties">
                <div class="empty-state text-center">
                    <i class="fas fa-home fa-4x mb-3"></i>
                    <h4>Sem Propriedades</h4>
                    <p class="text-muted">Ainda não criou nenhuma propriedade.</p>
                    <a href="@Url.Action("Create", "Properties")" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Criar Primeira Propriedade
                    </a>
                </div>
            </div>
        }
    </div>
</section>

<!-- Quick Actions -->
<section class="quick-actions py-5">
    <div class="container">
        <div class="section-header mb-5">
            <h2 class="section-title">
                <i class="fas fa-bolt me-2"></i>Ações Rápidas
            </h2>
            <p class="section-subtitle">Tarefas comuns do seu dia a dia</p>
        </div>
        
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="action-card">
                    <div class="action-icon">
                        <i class="fas fa-plus fa-2x"></i>
                    </div>
                    <h5>Adicionar Propriedade</h5>
                    <p class="text-muted">Criar nova listagem de propriedade</p>
                    <a href="@Url.Action("Create", "Properties")" class="btn btn-success btn-sm">
                        <i class="fas fa-plus me-1"></i>Adicionar
                    </a>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="action-card">
                    <div class="action-icon">
                        <i class="fas fa-list fa-2x"></i>
                    </div>
                    <h5>Ver Todas as Propriedades</h5>
                    <p class="text-muted">Explorar todas as propriedades da agência</p>
                    <a href="@Url.Action("Properties", "Home", new { agency = agency })" class="btn btn-primary btn-sm">
                        <i class="fas fa-eye me-1"></i>Ver
                    </a>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="action-card">
                    <div class="action-icon">
                        <i class="fas fa-chart-bar fa-2x"></i>
                    </div>
                    <h5>Ver Estatísticas</h5>
                    <p class="text-muted">Analisar o desempenho das suas propriedades</p>
                    <a href="#" class="btn btn-info btn-sm">
                        <i class="fas fa-chart-line me-1"></i>Ver
                    </a>
                </div>
            </div>
        </div>
    </div>
</section> 