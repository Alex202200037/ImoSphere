@inject IViewLocalizer Localizer
@model ImoSphere.Models.ApplicationUser
@{
    ViewData["Title"] = Localizer["CommercialProfileTitle"];
    var casas = ViewBag.Casas as List<ImoSphere.Models.Property>;
    var agency = ViewBag.Agency as string;
    var logoFile = $"/images/{agency?.ToLower()}.png";
}

<link rel="stylesheet" href="~/css/perfil-comercial.css" asp-append-version="true" />

<section class="glass-section py-5">
    <!-- Profile Hero Section -->
    <section class="profile-hero py-5">
        <div class="container">
            <div class="profile-header">
                <div class="row align-items-center">
                    <div class="col-lg-3 text-center">
                        <div class="profile-avatar">
                            <i class="fas fa-user fa-4x"></i>
                        </div>
                        <div class="profile-badge">
                            <span class="badge bg-success">@Localizer["CommercialBadge"]</span>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="profile-info">
                            <h1 class="profile-name">@Model.UserName</h1>
                            <p class="profile-email">@Model.Email</p>
                            <div class="agency-info">
                                <img src="@logoFile" alt="@agency Logo" class="agency-logo" />
                                <h4 class="agency-name">@agency</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 text-end">
                        <div class="profile-actions">
                            <a href="@Url.Action("Properties", "Home", new { agency = agency })" class="btn btn-primary">
                                <i class="fas fa-home me-2"></i>@Localizer["ViewProperties"]
                            </a>
                            <a href="@Url.Action("Create", "Properties")" class="btn btn-success mt-2">
                                <i class="fas fa-plus me-2"></i>@Localizer["AddProperty"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Statistics Dashboard -->
    <section class="stats-dashboard py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="fas fa-home"></i>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@(casas?.Count ?? 0)</h3>
                            <p class="stat-label">@Localizer["MyProperties"]</p>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="fas fa-euro-sign"></i>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">€@(casas?.Sum(c => c.Price).ToString("N0") ?? "0")</h3>
                            <p class="stat-label">@Localizer["TotalValue"]</p>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@(casas != null && casas.Any() ? casas.Average(c => c.Price).ToString("N0") : "0")</h3>
                            <p class="stat-label">@Localizer["AveragePrice"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- My Properties -->
    <section class="my-properties py-5">
        <div class="container">
            <div class="section-header mb-5">
                <h2 class="section-title">
                    <i class="fas fa-home me-2"></i>@Localizer["MyPropertiesTitle"]
                </h2>
                <p class="section-subtitle">@Localizer["MyPropertiesSubtitle"]</p>
            </div>
            
            @if (casas != null && casas.Any())
            {
                <div class="row g-4">
                    @foreach (var casa in casas)
                    {
                        <div class="col-lg-6 col-xl-4">
                            <div class="card property-card pro-list h-100 hover-lift" data-property-id="@casa.Id" style="position:relative;">
                                @if (casa.Images != null && casa.Images.Any())
                                {
                                    <img src="@casa.Images.First().ImageUrl" class="card-img-top property-image" alt="@casa.Name" />
                                }
                                else
                                {
                                    <div class="property-image-placeholder">
                                        <i class="fas fa-home fa-3x text-muted"></i>
                                    </div>
                                }
                                <div class="property-price-badge" style="position: absolute; top: 10px; right: 10px; z-index: 12;">
                                    €@casa.Price.ToString("N0")
                                </div>
                                <div class="card-body">
                                    <h6 class="card-title">@casa.Name</h6>
                                    <p class="card-text mb-1"><i class="fas fa-map-marker-alt me-1"></i>@casa.Location</p>
                                    <div class="property-features d-flex gap-3 mb-2">
                                        <span class="feature"><i class="fas fa-bed text-primary"></i> @casa.Bedrooms</span>
                                        <span class="feature"><i class="fas fa-bath text-primary"></i> @casa.Bathrooms</span>
                                        <span class="feature"><i class="fas fa-ruler-combined text-primary"></i> @casa.Area m²</span>
                                    </div>
                                    <div class="agency-info mt-2">
                                        <small class="text-muted">
                                            <i class="fas fa-building me-1"></i>@casa.Agency?.Name
                                        </small>
                                    </div>
                                </div>
                                <div class="card-footer">
                                    <div class="d-flex justify-content-end align-items-center gap-2">
                                        <a href="@Url.Action("Edit", "Properties", new { id = casa.Id })" class="btn btn-outline-warning btn-sm" title="@Localizer["Edit"]">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Details", "Properties", new { id = casa.Id })" class="btn btn-outline-primary btn-sm" title="@Localizer["ViewDetails"]">
                                            <i class="fas fa-eye me-1"></i>@Localizer["View"]
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-properties">
                    <div class="empty-state text-center">
                        <i class="fas fa-home fa-4x mb-3"></i>
                        <h4>@Localizer["NoProperties"]</h4>
                        <p class="text-muted">@Localizer["NoPropertiesCreated"]</p>
                        <a href="@Url.Action("Create", "Properties")" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>@Localizer["CreateFirstProperty"]
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Quick Actions -->
    <section class="quick-actions py-5">
        <div class="container">
            <div class="section-header mb-5">
                <h2 class="section-title">
                    <i class="fas fa-bolt me-2"></i>@Localizer["QuickActionsTitle"]
                </h2>
                <p class="section-subtitle">@Localizer["QuickActionsSubtitle"]</p>
            </div>
            
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="action-card">
                        <div class="action-icon">
                            <i class="fas fa-plus"></i>
                        </div>
                        <h5>@Localizer["AddProperty"]</h5>
                        <p class="text-muted">@Localizer["AddPropertyDesc"]</p>
                        <a href="@Url.Action("Create", "Properties")" class="btn btn-success btn-sm">
                            <i class="fas fa-plus me-1"></i>@Localizer["Add"]
                        </a>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6">
                    <div class="action-card">
                        <div class="action-icon">
                            <i class="fas fa-list"></i>
                        </div>
                        <h5>@Localizer["ViewAllProperties"]</h5>
                        <p class="text-muted">@Localizer["ViewAllPropertiesDesc"]</p>
                        <a href="@Url.Action("Properties", "Home", new { agency = agency })" class="btn btn-primary btn-sm">
                            <i class="fas fa-eye me-1"></i>@Localizer["View"]
                        </a>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6">
                    <div class="action-card">
                        <div class="action-icon">
                            <i class="fas fa-chart-bar fa-2x"></i>
                        </div>
                        <h5>@Localizer["ViewStatistics"]</h5>
                        <p class="text-muted">@Localizer["ViewStatisticsDesc"]</p>
                        <a href="#" class="btn btn-info btn-sm">
                            <i class="fas fa-chart-line me-1"></i>@Localizer["View"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</section> 