@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "Privacy Policy";
}

<!-- Hero Section -->
<section class="privacy-hero glass-section py-5">
    <div class="container">
        <div class="text-center">
            <h1 class="display-4 fw-bold mb-4">
                <i class="fas fa-shield-alt text-primary me-2"></i>@Localizer["PrivacyPolicy"]
            </h1>
            <p class="lead mb-4">
                @Localizer["PrivacyPolicyDescription"]
            </p>
            <div class="last-updated">
                <small class="text-muted">
                    <i class="fas fa-calendar-alt me-1"></i>@Localizer["LastUpdated"]
                </small>
            </div>
        </div>
    </div>
</section>

<!-- Policy Content -->
<section class="policy-content glass-section py-5">
    <div class="container">
        <div class="d-flex align-items-start">
            <div class="policy-nav" style="top: 32px;">
                <div class="card glass-card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-list me-2"></i>@Localizer["Contents"]
                        </h5>
                    </div>
                    <div class="card-body">
                        <nav class="nav flex-column">
                            <a class="nav-link" href="#introduction">
                                <i class="fas fa-info-circle me-2"></i>@Localizer["Introduction"]
                            </a>
                            <a class="nav-link" href="#information-collection">
                                <i class="fas fa-database me-2"></i>@Localizer["InformationCollection"]
                            </a>
                            <a class="nav-link" href="#information-use">
                                <i class="fas fa-cogs me-2"></i>@Localizer["HowWeUseInformation"]
                            </a>
                            <a class="nav-link" href="#information-sharing">
                                <i class="fas fa-share-alt me-2"></i>@Localizer["InformationSharing"]
                            </a>
                            <a class="nav-link" href="#data-security">
                                <i class="fas fa-lock me-2"></i>@Localizer["DataSecurity"]
                            </a>
                            <a class="nav-link" href="#your-rights">
                                <i class="fas fa-user-shield me-2"></i>@Localizer["YourRights"]
                            </a>
                            <a class="nav-link" href="#cookies">
                                <i class="fas fa-cookie-bite me-2"></i>@Localizer["CookiesPolicy"]
                            </a>
                            <a class="nav-link" href="#contact">
                                <i class="fas fa-envelope me-2"></i>@Localizer["ContactUs"]
                            </a>
                        </nav>
                    </div>
                </div>
            </div>
            <div class="flex-grow-1 ms-4">
                <div class="policy-sections">
                    <!-- Introduction -->
                    <section id="introduction" class="policy-section glass-card">
                        <div class="section-header">
                            <h2>
                                <i class="fas fa-info-circle text-primary me-2"></i>@Localizer["Introduction"]
                            </h2>
                        </div>
                        <div class="section-content">
                            <p>
                                @Localizer["IntroductionDescription"]
                            </p>
                            <p>
                                @Localizer["IntroductionCompliance"]
                            </p>
                            <div class="info-box">
                                <div class="info-icon">
                                    <i class="fas fa-lightbulb text-warning"></i>
                                </div>
                                <div class="info-content">
                                    <h6>@Localizer["KeyPoints"]</h6>
                                    <ul class="mb-0">
                                        <li>@Localizer["KeyPoint1"]</li>
                                        <li>@Localizer["KeyPoint2"]</li>
                                        <li>@Localizer["KeyPoint3"]</li>
                                        <li>@Localizer["KeyPoint4"]</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Information Collection -->
                    <section id="information-collection" class="policy-section glass-card">
                        <div class="section-header">
                            <h2>
                                <i class="fas fa-database text-primary me-2"></i>@Localizer["InformationWeCollect"]
                            </h2>
                        </div>
                        <div class="section-content">
                            <h5>@Localizer["PersonalInformation"]</h5>
                            <p>@Localizer["PersonalInformationDescription"]</p>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <div class="info-card glass-card">
                                        <div class="info-card-icon">
                                            <i class="fas fa-user text-primary"></i>
                                        </div>
                                        <h6>@Localizer["AccountInformation"]</h6>
                                        <ul class="mb-0">
                                            <li>@Localizer["AccountInformationItem1"]</li>
                                            <li>@Localizer["AccountInformationItem2"]</li>
                                            <li>@Localizer["AccountInformationItem3"]</li>
                                            <li>@Localizer["AccountInformationItem4"]</li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-card glass-card">
                                        <div class="info-card-icon">
                                            <i class="fas fa-home text-success"></i>
                                        </div>
                                        <h6>@Localizer["PropertyInformation"]</h6>
                                        <ul class="mb-0">
                                            <li>@Localizer["PropertyInformationItem1"]</li>
                                            <li>@Localizer["PropertyInformationItem2"]</li>
                                            <li>@Localizer["PropertyInformationItem3"]</li>
                                            <li>@Localizer["PropertyInformationItem4"]</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <h5>@Localizer["AutomaticallyCollectedInformation"]</h5>
                            <p>@Localizer["AutomaticallyCollectedInformationDescription"]</p>
                            <div class="tech-info">
                                <div class="tech-item">
                                    <i class="fas fa-globe text-info"></i>
                                    <span>@Localizer["IPAddressAndLocationData"]</span>
                                </div>
                                <div class="tech-item">
                                    <i class="fas fa-desktop text-info"></i>
                                    <span>@Localizer["DeviceAndBrowserInformation"]</span>
                                </div>
                                <div class="tech-item">
                                    <i class="fas fa-clock text-info"></i>
                                    <span>@Localizer["UsagePatternsAndAnalytics"]</span>
                                </div>
                                <div class="tech-item">
                                    <i class="fas fa-cookie-bite text-info"></i>
                                    <span>@Localizer["CookieAndTrackingData"]</span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Information Use -->
                    <section id="information-use" class="policy-section glass-card">
                        <div class="section-header">
                            <h2>
                                <i class="fas fa-cogs text-primary me-2"></i>@Localizer["HowWeUseYourInformation"]
                            </h2>
                        </div>
                        <div class="section-content">
                            <p>@Localizer["HowWeUseYourInformationDescription"]</p>
                            <div class="usage-grid">
                                <div class="usage-item glass-card">
                                    <div class="usage-icon">
                                        <i class="fas fa-search text-primary"></i>
                                    </div>
                                    <h6>@Localizer["ServiceProvision"]</h6>
                                    <p>@Localizer["ServiceProvisionDescription"]</p>
                                </div>
                                <div class="usage-item glass-card">
                                    <div class="usage-icon">
                                        <i class="fas fa-bell text-success"></i>
                                    </div>
                                    <h6>@Localizer["Communication"]</h6>
                                    <p>@Localizer["CommunicationDescription"]</p>
                                </div>
                                <div class="usage-item glass-card">
                                    <div class="usage-icon">
                                        <i class="fas fa-chart-line text-warning"></i>
                                    </div>
                                    <h6>@Localizer["Analytics"]</h6>
                                    <p>@Localizer["AnalyticsDescription"]</p>
                                </div>
                                <div class="usage-item glass-card">
                                    <div class="usage-icon">
                                        <i class="fas fa-shield-alt text-danger"></i>
                                    </div>
                                    <h6>@Localizer["Security"]</h6>
                                    <p>@Localizer["SecurityDescription"]</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Information Sharing -->
                    <section id="information-sharing" class="policy-section glass-card">
                        <div class="section-header">
                            <h2>
                                <i class="fas fa-share-alt text-primary me-2"></i>@Localizer["InformationSharing"]
                            </h2>
                        </div>
                        <div class="section-content">
                            <p>@Localizer["InformationSharingDescription"]</p>

                            <div class="sharing-scenarios">
                                <div class="scenario-item glass-card">
                                    <div class="scenario-icon">
                                        <i class="fas fa-handshake text-success"></i>
                                    </div>
                                    <div class="scenario-content">
                                        <h6>@Localizer["WithYourConsent"]</h6>
                                        <p>@Localizer["WithYourConsentDescription"]</p>
                                    </div>
                                </div>

                                <div class="scenario-item glass-card">
                                    <div class="scenario-icon">
                                        <i class="fas fa-building text-primary"></i>
                                    </div>
                                    <div class="scenario-content">
                                        <h6>@Localizer["RealEstatePartners"]</h6>
                                        <p>@Localizer["RealEstatePartnersDescription"]</p>
                                    </div>
                                </div>

                                <div class="scenario-item glass-card">
                                    <div class="scenario-icon">
                                        <i class="fas fa-gavel text-warning"></i>
                                    </div>
                                    <div class="scenario-content">
                                        <h6>@Localizer["LegalRequirements"]</h6>
                                        <p>@Localizer["LegalRequirementsDescription"]</p>
                                    </div>
                                </div>

                                <div class="scenario-item glass-card">
                                    <div class="scenario-icon">
                                        <i class="fas fa-shield-alt text-danger"></i>
                                    </div>
                                    <div class="scenario-content">
                                        <h6>@Localizer["SecurityProtection"]</h6>
                                        <p>@Localizer["SecurityProtectionDescription"]</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Data Security -->
                    <section id="data-security" class="policy-section glass-card">
                        <div class="section-header">
                            <h2>
                                <i class="fas fa-lock text-primary me-2"></i>@Localizer["DataSecurity"]
                            </h2>
                        </div>
                        <div class="section-content">
                            <p>@Localizer["DataSecurityDescription"]</p>

                            <div class="security-features">
                                <div class="security-item">
                                    <div class="security-item-icon">
                                        <i class="fas fa-lock text-warning"></i>
                                    </div>
                                    <div>
                                        <h6>@Localizer["Encryption"]</h6>
                                        <p>@Localizer["EncryptionDescription"]</p>
                                    </div>
                                </div>
                                <div class="security-item">
                                    <i class="fas fa-server text-primary"></i>
                                    <div>
                                        <h6>@Localizer["SecureServers"]</h6>
                                        <p>@Localizer["SecureServersDescription"]</p>
                                    </div>
                                </div>
                                <div class="security-item">
                                    <i class="fas fa-user-lock text-warning"></i>
                                    <div>
                                        <h6>@Localizer["AccessControl"]</h6>
                                        <p>@Localizer["AccessControlDescription"]</p>
                                    </div>
                                </div>
                                <div class="security-item">
                                    <i class="fas fa-shield-virus text-danger"></i>
                                    <div>
                                        <h6>@Localizer["RegularAudits"]</h6>
                                        <p>@Localizer["RegularAuditsDescription"]</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Your Rights -->
                    <section id="your-rights" class="policy-section glass-card">
                        <div class="section-header">
                            <h2>
                                <i class="fas fa-user-shield text-primary me-2"></i>@Localizer["YourRights"]
                            </h2>
                        </div>
                        <div class="section-content">
                            <p>@Localizer["YourRightsDescription"]</p>

                            <div class="rights-grid">
                                <div class="right-item glass-card">
                                    <div class="right-icon">
                                        <i class="fas fa-eye text-primary"></i>
                                    </div>
                                    <h6>@Localizer["RightToAccess"]</h6>
                                    <p>@Localizer["RightToAccessDescription"]</p>
                                </div>
                                <div class="right-item glass-card">
                                    <div class="right-icon">
                                        <i class="fas fa-edit text-success"></i>
                                    </div>
                                    <h6>@Localizer["RightToRectification"]</h6>
                                    <p>@Localizer["RightToRectificationDescription"]</p>
                                </div>
                                <div class="right-item glass-card">
                                    <div class="right-icon">
                                        <i class="fas fa-trash text-danger"></i>
                                    </div>
                                    <h6>@Localizer["RightToErasure"]</h6>
                                    <p>@Localizer["RightToErasureDescription"]</p>
                                </div>
                                <div class="right-item glass-card">
                                    <div class="right-icon">
                                        <i class="fas fa-pause text-warning"></i>
                                    </div>
                                    <h6>@Localizer["RightToRestriction"]</h6>
                                    <p>@Localizer["RightToRestrictionDescription"]</p>
                                </div>
                                <div class="right-item glass-card">
                                    <div class="right-icon">
                                        <i class="fas fa-download text-info"></i>
                                    </div>
                                    <h6>@Localizer["RightToPortability"]</h6>
                                    <p>@Localizer["RightToPortabilityDescription"]</p>
                                </div>
                                <div class="right-item glass-card">
                                    <div class="right-icon">
                                        <i class="fas fa-ban text-secondary"></i>
                                    </div>
                                    <h6>@Localizer["RightToObject"]</h6>
                                    <p>@Localizer["RightToObjectDescription"]</p>
                                </div>
                            </div>

                            <div class="contact-info-box glass-card">
                                <h6>@Localizer["ExerciseYourRights"]</h6>
                                <p>@Localizer["ExerciseYourRightsDescription"]</p>
                                <div class="contact-methods">
                                    <div class="contact-method">
                                        <i class="fas fa-envelope text-primary"></i>
                                        <span>@Localizer["Email"]</span>
                                    </div>
                                    <div class="contact-method">
                                        <i class="fas fa-phone text-primary"></i>
                                        <span>@Localizer["Phone"]</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Cookies Policy -->
                    <section id="cookies" class="policy-section glass-card">
                        <div class="section-header">
                            <h2>
                                <i class="fas fa-cookie-bite text-primary me-2"></i>@Localizer["CookiesPolicy"]
                            </h2>
                        </div>
                        <div class="section-content">
                            <p>@Localizer["CookiesPolicyDescription"]</p>

                            <div class="cookies-types">
                                <div class="cookie-type glass-card">
                                    <h6>@Localizer["EssentialCookies"]</h6>
                                    <p>@Localizer["EssentialCookiesDescription"]</p>
                                    <span class="cookie-badge essential">@Localizer["CannotBeDisabled"]</span>
                                </div>
                                <div class="cookie-type glass-card">
                                    <h6>@Localizer["AnalyticsCookies"]</h6>
                                    <p>@Localizer["AnalyticsCookiesDescription"]</p>
                                    <span class="cookie-badge analytics">@Localizer["CanBeDisabled"]</span>
                                </div>
                                <div class="cookie-type glass-card">
                                    <h6>@Localizer["MarketingCookies"]</h6>
                                    <p>@Localizer["MarketingCookiesDescription"]</p>
                                    <span class="cookie-badge marketing">@Localizer["CanBeDisabled"]</span>
                                </div>
                            </div>

                            <div class="cookie-controls glass-card">
                                <h6>@Localizer["CookiePreferences"]</h6>
                                <p>@Localizer["CookiePreferencesDescription"]</p>
                                <button class="btn btn-outline-primary" onclick="openCookieSettings()">
                                    <i class="fas fa-cog me-2"></i>@Localizer["ManageCookieSettings"]
                                </button>
                            </div>
                        </div>
                    </section>

                    <!-- Contact -->
                    <section id="contact" class="policy-section glass-card">
                        <div class="section-header">
                            <h2>
                                <i class="fas fa-envelope text-primary me-2"></i>@Localizer["ContactUs"]
                            </h2>
                        </div>
                        <div class="section-content">
                            <p>@Localizer["ContactUsDescription"]</p>

                            <div class="contact-details">
                                <div class="contact-card glass-card">
                                    <div class="contact-icon">
                                        <i class="fas fa-envelope text-primary"></i>
                                    </div>
                                    <div>
                                        <h6>@Localizer["Email"]</h6>
                                        <p>@Localizer["EmailAddress"]</p>
                                    </div>
                                </div>
                                <div class="contact-card glass-card">
                                    <div class="contact-icon">
                                        <i class="fas fa-phone text-primary"></i>
                                    </div>
                                    <div>
                                        <h6>@Localizer["Phone"]</h6>
                                        <p>@Localizer["PhoneNumber"]</p>
                                    </div>
                                </div>
                                <div class="contact-card glass-card">
                                    <div class="contact-icon">
                                        <i class="fas fa-map-marker-alt text-primary"></i>
                                    </div>
                                    <div>
                                        <h6>@Localizer["Address"]</h6>
                                        <p>@Localizer["AddressDescription"]</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function openCookieSettings() {
        // This would typically open a cookie consent modal
        alert('Cookie settings modal would open here. In a real implementation, this would show detailed cookie preferences.');
    }
</script>