@{
    ViewBag.Title = "Create User";
    var agencies = ViewBag.Agencies as List<ImoSphere.Models.Agency>;
    var isSuperAdmin = agencies != null;
}

<h2 class="text-center">Create User</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-action="CreateUser" method="post" class="contact-form">
    <div class="form-group">
        <label>Email</label>
        @if (isSuperAdmin) {
            <input type="email" name="email" class="form-control" required />
        } else {
            <div class="input-group">
                <input type="text" name="emailPrefix" class="form-control" required placeholder="Email prefix" />
                <div class="input-group-append">
                    <span class="input-group-text">@ViewBag.EmailDomain</span>
                </div>
            </div>
        }
    </div>

    <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="role">Role</label>
        <select id="role" name="role" class="form-control" required>
            <option value="Comercial">Comercial</option>
            <option value="Admin">Admin</option>
            <option value="User">User</option>
            @if (isSuperAdmin) { <option value="SuperAdmin">SuperAdmin</option> }
        </select>
    </div>

    <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" class="form-control" required />
    </div>

    @if (isSuperAdmin) {
        <div class="form-group">
            <label for="agencyId">Agency</label>
            <select id="agencyId" name="agencyId" class="form-control">
                <option value="">No agency (normal user)</option>
                @foreach (var agency in agencies) {
                    <option value="@agency.Id">@agency.Name</option>
                }
            </select>
        </div>
    } else {
        <div class="form-group">
            <label for="agency">Agency</label>
            <input type="text" id="agency" class="form-control" value="@User?.Identity?.Name's agency (fixed)" disabled />
        </div>
    }

    <div class="d-flex justify-content-between w-100">
        <button type="submit" class="btn btn-primary w-50 me-2">Create User</button>
        <a asp-action="Users" class="btn btn-secondary w-50">Cancel</a>
    </div>
</form>