@{
    ViewBag.Title = "Create User";
    var agencies = (ViewBag.Agencies as List<ImoSphere.Models.Agency>)?.Where(a => a.Name.ToLower() != "imosphere").ToList()
    ?? new List<ImoSphere.Models.Agency>();
    var isSuperAdmin = agencies != null && agencies.Count > 0;
    var isAdmin = !isSuperAdmin;
}
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<div class="users-management-container">
    <div class="page-header mb-4">
        <h2><i class="fas fa-user-plus"></i> @Localizer["CreateUser"]</h2>
        <a asp-action="Users" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> @Localizer["BackToManageUsers"]
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @Localizer["PleaseFixErrors"]
            <ul class="mb-0 mt-2">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-lg p-4 mx-auto"
        style="max-width: 500px; border-radius: 18px; background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%); border: 1px solid rgba(136,68,255,0.15);">
        <form asp-action="CreateUser" method="post" autocomplete="off">
            <div class="mb-3">
                <label for="role" class="form-label"><i class="fas fa-user-tag"></i> @Localizer["Role"]</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-user-tag"></i></span>
                    <select id="role" name="role" class="form-select" required>
                        @if (isSuperAdmin)
                        {
                            <option value="Comercial">Comercial</option>
                            <option value="Admin">Admin</option>
                            <option value="User">User</option>
                            <option value="SuperAdmin">SuperAdmin</option>
                        }
                        else
                        {
                            <option value="Comercial">Comercial</option>
                        }
                    </select>
                </div>
            </div>

            @if (isSuperAdmin)
            {
                <div class="mb-3" id="agencyField">
                    <label for="agencyId" class="form-label"><i class="fas fa-building"></i> @Localizer["Agency"]</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-building"></i></span>
                        <select id="agencyId" name="agencyId" class="form-select">
                            <option value="">Select agency</option>
                            @foreach (var agency in agencies)
                            {
                                <option value="@agency.Id"
                                    data-domain="@($".{agency.Name.ToLower().Replace(" ", "")}")&#64;imosphere.com">@agency.Name
                                </option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-3" id="adminField" style="display:none;">
                    <label for="adminId" class="form-label"><i class="fas fa-user-shield"></i>
                        @Localizer["ResponsibleAdmin"]</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user-shield"></i></span>
                        <select id="adminId" name="adminId" class="form-select">
                            <option value="">Select admin</option>
                        </select>
                    </div>
                </div>
            }

            <div class="mb-3" id="emailPrefixGroup">
                <label class="form-label"><i class="fas fa-envelope"></i> @Localizer["Email"]</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-at"></i></span>
                    <input type="text" id="emailPrefix" name="emailPrefix" class="form-control" required
                        placeholder="Email prefix" autocomplete="off" />
                    <span class="input-group-text" id="emailDomain">
                        @(ViewBag.EmailDomain)
                    </span>
                </div>
            </div>
            <div class="mb-3" id="emailFullGroup" style="display:none;">
                <label class="form-label"><i class="fas fa-envelope"></i> @Localizer["Email"]</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-at"></i></span>
                    <input type="email" id="emailFull" name="email" class="form-control" placeholder="Email completo"
                        autocomplete="off" />
                </div>
            </div>

            <div class="mb-3">
                <label for="username" class="form-label"><i class="fas fa-user"></i> @Localizer["Username"]</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                    <input type="text" id="username" name="username" class="form-control" required
                        placeholder="Username" />
                </div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label"><i class="fas fa-lock"></i> @Localizer["Password"]</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input type="password" id="password" name="password" class="form-control" required
                        placeholder="Password" />
                </div>
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn btn-primary flex-fill py-2">
                    <i class="fas fa-user-plus"></i> @Localizer["CreateUser"]
                </button>
                <a asp-action="Users" class="btn btn-outline-secondary flex-fill py-2">
                    <i class="fas fa-times"></i> @Localizer["Cancel"]
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const roleSelect = document.getElementById('role');
        const agencyField = document.getElementById('agencyField');
        const agencySelect = document.getElementById('agencyId');
        const adminField = document.getElementById('adminField');
        const adminSelect = document.getElementById('adminId');
        const emailDomain = document.getElementById('emailDomain');
        const emailPrefixGroup = document.getElementById('emailPrefixGroup');
        const emailFullGroup = document.getElementById('emailFullGroup');
        const emailPrefix = document.getElementById('emailPrefix');
        const emailFull = document.getElementById('emailFull');

        function updateAgencyAndDomain() {
            const role = roleSelect.value;
            if (role === 'SuperAdmin' || role === 'User') {
                agencyField.style.display = 'none';
                agencySelect.removeAttribute('required');
                adminField.style.display = 'none';
                agencySelect.value = '';
                // Email: campo completo
                emailPrefixGroup.style.display = 'none';
                emailFullGroup.style.display = '';
                emailPrefix.removeAttribute('required');
                emailFull.setAttribute('required', 'required');
                if (role === 'SuperAdmin') {
                    emailFull.value = '';
                    emailFull.placeholder = 'exemplo.imosphere@imosphere.com';
                } else {
                    emailFull.value = '';
                    emailFull.placeholder = 'exemplo@email.com';
                }
            } else {
                agencyField.style.display = '';
                agencySelect.setAttribute('required', 'required');
                // Mostrar adminField só se for Comercial
                if (role === 'Comercial') {
                    adminField.style.display = '';
                    loadAdmins();
                } else {
                    adminField.style.display = 'none';
                }
                // Email: prefix + domínio
                emailPrefixGroup.style.display = '';
                emailFullGroup.style.display = 'none';
                emailPrefix.setAttribute('required', 'required');
                emailFull.removeAttribute('required');
                // Atualiza domínio conforme agência
                const selected = agencySelect.options[agencySelect.selectedIndex];
                let domain = selected.getAttribute('data-domain');
                if (!domain || domain.startsWith('.imosphere')) {
                    domain = '&#64;imosphere.com';
                }
                emailDomain.innerHTML = domain;
            }
        }

        function loadAdmins() {
            const agencyId = agencySelect.value;
            adminSelect.innerHTML = '<option value="">Select admin</option>';
            if (!agencyId) return;
            fetch(`/Admin/GetAdminsByAgency?agencyId=${agencyId}`)
                .then(r => r.json())
                .then(admins => {
                    admins.forEach(a => {
                        const opt = document.createElement('option');
                        opt.value = a.id;
                        opt.textContent = a.userName;
                        adminSelect.appendChild(opt);
                    });
                });
        }

        roleSelect.addEventListener('change', updateAgencyAndDomain);
        agencySelect.addEventListener('change', function () {
            if (roleSelect.value !== 'SuperAdmin') {
                const selected = agencySelect.options[agencySelect.selectedIndex];
                let domain = selected.getAttribute('data-domain');
                if (!domain || domain.startsWith('.imosphere')) {
                    domain = '&#64;imosphere.com';
                }
                emailDomain.innerHTML = domain;
                if (roleSelect.value === 'Comercial') {
                    loadAdmins();
                }
            }
        });
        updateAgencyAndDomain(); // inicial
    });
</script>