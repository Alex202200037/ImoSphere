@model List<ImoSphere.Models.UserWithRolesViewModel>
@using ImoSphere.Data;
@inject ApplicationDbContext _context;
@{
    ViewBag.Title = "Users";
    var isSuperAdmin = User.IsInRole("SuperAdmin");
}
<h2>Users</h2>
@if (TempData["SuccessMessage"] != null) {
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null) {
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
<a class="btn btn-primary mb-2" asp-action="CreateUser">Create New User</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Email</th>
            <th>Username</th>
            <th>Role(s)</th>
            <th>Agency</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model) {
            var agencyUser = _context.AgencyUsers.FirstOrDefault(au => au.UserId == user.User.Id);
            string agencyName = agencyUser != null ? _context.Agencies.Find(agencyUser.AgencyId)?.Name : "No agency";
            <tr>
                <td>@user.User.Email</td>
                <td>@user.User.UserName</td>
                <td>@string.Join(", ", user.Roles)</td>
                <td>@agencyName</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="EditUser" asp-route-id="@user.User.Id">Edit</a>
                    <form asp-action="DeleteUser" asp-route-id="@user.User.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>