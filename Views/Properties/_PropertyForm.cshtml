@model ImoSphere.Models.Property
@{
    var safeModel = Model ?? new ImoSphere.Models.Property();
    var isCreate = ViewBag.IsCreate != null && (bool)ViewBag.IsCreate;
    var isEdit = !isCreate;
    var userRole = ViewBag.UserRole as string;
}



<!-- Agency and User Selection -->
@if (userRole == "SuperAdmin" && isCreate)
{
    <div class="form-group">
        <label for="AgencyId"><i class="fas fa-building"></i>Agência</label>
        @Html.DropDownListFor(m => m.AgencyId, (SelectList)ViewBag.Agencies, "Selecione a agência", new { @class = "form-control", id = "agencyDropdown" })
    </div>
    <div class="form-group">
        <label for="CreatedByUserId"><i class="fas fa-user-tie"></i>Comercial Responsável</label>
        <select id="comercialDropdown" name="CreatedByUserId" class="form-control">
            <option value="">Selecione o comercial</option>
            @if (ViewBag.AgencyComerciais != null)
            {
                foreach (var comercial in (SelectList)ViewBag.AgencyComerciais)
                {
                    var isSelected = safeModel.CreatedByUserId == comercial.Value;
                    @:<text><option value="@comercial.Value"@(isSelected ? " selected=\"selected\"" : "")>@comercial.Text</option></text>
                }
            }
        </select>
    </div>
    <script>
        function loadComerciais(agencyId) {
            var comercialDropdown = document.getElementById('comercialDropdown');
            comercialDropdown.innerHTML = '';
            var defaultOpt = document.createElement('option');
            defaultOpt.value = '';
            defaultOpt.text = 'Selecione o comercial';
            comercialDropdown.appendChild(defaultOpt);
            if (!agencyId) return;
            fetch('/Properties/GetComerciaisByAgency?agencyId=' + agencyId)
                .then(response => response.json())
                .then(data => {
                    data.forEach(function (user) {
                        var opt = document.createElement('option');
                        opt.value = user.id;
                        opt.text = user.userName;
                        comercialDropdown.appendChild(opt);
                    });
                });
        }
        document.getElementById('agencyDropdown').addEventListener('change', function () {
            loadComerciais(this.value);
        });
    </script>
}
else if (userRole == "SuperAdmin" && isEdit)
{
    <div class="form-group">
        <label><i class="fas fa-building"></i>Agência</label>
        <input type="text" class="form-control" value="@safeModel.Agency?.Name" readonly />
    </div>
    <div class="form-group">
        <label><i class="fas fa-user-tie"></i>Comercial Responsável</label>
        <input type="text" class="form-control" value="@safeModel.CreatedByUser?.UserName" readonly />
    </div>
}
else if (userRole == "Admin")
{
    <div class="form-group">
        <label><i class="fas fa-building"></i>Agência</label>
        <input type="text" class="form-control" value="@safeModel.Agency?.Name" readonly />
    </div>
    <div class="form-group">
        <label for="CreatedByUserId"><i class="fas fa-user-tie"></i>Comercial Responsável</label>
        @Html.DropDownListFor(m => m.CreatedByUserId, (SelectList)ViewBag.Comerciais, "Selecione o comercial", new { @class = "form-control" })
    </div>
}
else
{
    <div class="form-group">
        <label><i class="fas fa-building"></i>Agência</label>
        <input type="text" class="form-control" value="@safeModel.Agency?.Name" readonly />
    </div>
    <div class="form-group">
        <label><i class="fas fa-user-tie"></i>Comercial Responsável</label>
        <input type="text" class="form-control" value="@safeModel.CreatedByUser?.UserName" readonly />
    </div>
}

<!-- Property Details -->
<div class="form-group">
    <label asp-for="Name"><i class="fas fa-home"></i>Nome da Propriedade</label>
    <input asp-for="Name" class="form-control" value="@safeModel.Name" placeholder="Ex: Moradia T4 em Cascais" />
</div>

<div class="form-group">
    <label asp-for="Description"><i class="fas fa-align-left"></i>Descrição</label>
    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Descreva as características da propriedade...">@safeModel.Description</textarea>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="Price"><i class="fas fa-euro-sign"></i>Preço (€)</label>
            <input asp-for="Price" class="form-control" value="@safeModel.Price" placeholder="500000" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="Area"><i class="fas fa-ruler-combined"></i>Área (m²)</label>
            <input asp-for="Area" class="form-control" value="@safeModel.Area" placeholder="150" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <label asp-for="Bedrooms"><i class="fas fa-bed"></i>Quartos</label>
            <input asp-for="Bedrooms" class="form-control" value="@safeModel.Bedrooms" placeholder="3" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label asp-for="Bathrooms"><i class="fas fa-bath"></i>WC's</label>
            <input asp-for="Bathrooms" class="form-control" value="@safeModel.Bathrooms" placeholder="2" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label asp-for="YearBuilt"><i class="fas fa-calendar-alt"></i>Ano de Construção</label>
            <input asp-for="YearBuilt" class="form-control" value="@safeModel.YearBuilt" placeholder="2020" />
        </div>
    </div>
</div>

<div class="form-group">
    <label asp-for="Location"><i class="fas fa-map-marker-alt"></i>Localização</label>
    <div class="location-input-group">
        <input asp-for="Location" class="form-control location-input" id="locationInput" autocomplete="off" value="@safeModel.Location" placeholder="Ex: Cascais, Lisboa" />
        <button type="button" id="openMapBtn" class="btn btn-secondary" title="Escolher no mapa">
            <i class="fas fa-map"></i>
        </button>
    </div>
</div>

<input type="hidden" name="Latitude" id="latitudeInput" value="@safeModel.Latitude" />
<input type="hidden" name="Longitude" id="longitudeInput" value="@safeModel.Longitude" />

@if (isEdit)
{
    <input type="hidden" asp-for="Id" value="@safeModel.Id" />
}

<!-- Image Upload -->
<div class="form-group">
    <label><i class="fas fa-images"></i>Imagens da Propriedade</label>
    <div class="image-upload-section">
        <div class="image-upload-icon">
            <i class="fas fa-cloud-upload-alt"></i>
        </div>
        <div class="image-upload-text">
            <p>Arraste as imagens para aqui ou clique para selecionar</p>
            <p class="text-muted">Formatos aceites: JPG, PNG, GIF (máx. 5MB cada)</p>
        </div>
        <input type="file" name="images" class="form-control" multiple accept="image/*" />
    </div>
</div>

@if (safeModel.Images != null && safeModel.Images.Any())
{
    <div class="form-group">
        <label><i class="fas fa-images"></i>Imagens Existentes</label>
        <div class="existing-images">
            @for (int i = 0; i < safeModel.Images.Count(); i++)
            {
                var img = safeModel.Images.ElementAt(i);
                <div class="image-thumb-container">
                    <img src="@img.ImageUrl" alt="Imagem @(i+1)" />
                    <input type="checkbox" name="removeImageIds" value="@img.Id" id="remove-img-@img.Id" class="remove-checkbox" />
                    <label for="remove-img-@img.Id" class="remove-label" title="Marcar para remover">
                        <i class="fas fa-times"></i>
                    </label>
                </div>
            }
        </div>
        <small class="text-muted">
            <i class="fas fa-info-circle"></i>
            Selecione as imagens a remover e clique em "Guardar Alterações".
        </small>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // --- Autocomplete Nominatim ---
        let acTimeout;
        const locInput = document.getElementById('locationInput');
        const latInput = document.getElementById('latitudeInput');
        const lngInput = document.getElementById('longitudeInput');
        let acList = document.createElement('div');
        acList.className = 'autocomplete-list';
        acList.style.width = locInput.offsetWidth + 'px';
        locInput.parentNode.appendChild(acList);
        
        locInput.addEventListener('input', function() {
            clearTimeout(acTimeout);
            if (this.value.length < 3) { 
                acList.style.display = 'none'; 
                return; 
            }
            acTimeout = setTimeout(() => {
                fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(this.value)}&addressdetails=1&limit=5`)
                    .then(res => res.json())
                    .then(data => {
                        acList.innerHTML = '';
                        data.forEach(item => {
                            let opt = document.createElement('div');
                            opt.className = 'autocomplete-item';
                            opt.textContent = item.display_name;
                            opt.onclick = () => {
                                locInput.value = item.display_name;
                                latInput.value = item.lat;
                                lngInput.value = item.lon;
                                acList.style.display = 'none';
                            };
                            acList.appendChild(opt);
                        });
                        acList.style.display = data.length ? 'block' : 'none';
                    });
            }, 300);
        });
        
        document.addEventListener('click', e => { 
            if (!acList.contains(e.target) && e.target !== locInput) 
                acList.style.display = 'none'; 
        });
        
        // --- Modal do mapa ---
        const mapModal = document.getElementById('mapModal');
        const openMapBtn = document.getElementById('openMapBtn');
        const closeMapBtn = document.getElementById('closeMapBtn');
        let map, marker;
        
        openMapBtn.onclick = function() {
            mapModal.classList.add('show');
            setTimeout(() => { 
                if (!map) initMap(); 
                else map.invalidateSize(); 
            }, 100);
        };
        
        closeMapBtn.onclick = function() { 
            mapModal.classList.remove('show'); 
        };
        
        function initMap() {
            let lat = parseFloat(latInput.value) || 38.7223;
            let lng = parseFloat(lngInput.value) || -9.1393;
            
            map = L.map('map').setView([lat, lng], 7);
            
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);
            
            marker = L.marker([lat, lng], {draggable: true}).addTo(map);
            
            marker.on('dragend', function(e) {
                let pos = marker.getLatLng();
                latInput.value = pos.lat;
                lngInput.value = pos.lng;
                fetch(`https://nominatim.openstreetmap.org/reverse?lat=${pos.lat}&lon=${pos.lng}&format=json`)
                    .then(res => res.json())
                    .then(data => { 
                        locInput.value = data.display_name || `${pos.lat}, ${pos.lng}`; 
                    });
            });
            
            map.on('click', function(e) {
                marker.setLatLng(e.latlng);
                latInput.value = e.latlng.lat;
                lngInput.value = e.latlng.lng;
                fetch(`https://nominatim.openstreetmap.org/reverse?lat=${e.latlng.lat}&lon=${e.latlng.lng}&format=json`)
                    .then(res => res.json())
                    .then(data => { 
                        locInput.value = data.display_name || `${e.latlng.lat}, ${e.latlng.lng}`; 
                    });
            });
        }
    </script>
}