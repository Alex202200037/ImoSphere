@model ImoSphere.Models.Property

@{
    ViewData["Title"] = "Adicionar Nova Propriedade";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var propertyModel = Model ?? new ImoSphere.Models.Property();
    var viewData = new ViewDataDictionary(ViewData);
    viewData.Remove("UserRole");
    viewData.Remove("IsCreate");
    viewData["UserRole"] = ViewBag.UserRole;
    viewData["IsCreate"] = ViewBag.IsCreate;
}

<link rel="stylesheet" href="~/css/property-form.css" asp-append-version="true" />

<!-- Hero Section -->
<section class="form-hero py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="form-header text-center">
                    <div class="form-icon">
                        <i class="fas fa-home fa-3x"></i>
                    </div>
                    <h1 class="form-title">Adicionar Nova Propriedade</h1>
                    <p class="form-subtitle">Preencha os detalhes da propriedade para criar uma nova listagem</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Form Section -->
<section class="form-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="form-card">
                    <form asp-action="Create" method="post" id="propertyForm" enctype="multipart/form-data">
                        @await Html.PartialAsync("_PropertyForm", Model, viewData)
                        
                        <div class="form-actions">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <button type="submit" class="btn btn-primary btn-lg w-100">
                                        <i class="fas fa-plus me-2"></i>Adicionar Propriedade
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <a asp-controller="Home" asp-action="Properties" class="btn btn-outline-secondary btn-lg w-100">
                                        <i class="fas fa-times me-2"></i>Cancelar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Map Modal -->
<div id="mapModal" class="map-modal">
    <div class="map-container">
        <div class="map-header">
            <h3><i class="fas fa-map-marker-alt me-2"></i>Selecionar Localização</h3>
            <button type="button" id="closeMapBtn" class="map-close-btn">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div id="map" class="map-content"></div>
        <div class="map-instructions">
            <p><i class="fas fa-info-circle me-2"></i>Clique no mapa para selecionar a localização ou arraste o marcador</p>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    
    <script>
        // Form validation and enhancement
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('propertyForm');
            const submitBtn = form.querySelector('button[type="submit"]');
            
            // Add loading state to submit button
            form.addEventListener('submit', function() {
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>A processar...';
                submitBtn.disabled = true;
            });
            
            // Auto-save draft functionality
            let autoSaveTimeout;
            const inputs = form.querySelectorAll('input, textarea, select');
            inputs.forEach(input => {
                input.addEventListener('input', function() {
                    clearTimeout(autoSaveTimeout);
                    autoSaveTimeout = setTimeout(() => {
                        // Save to localStorage as draft
                        const formData = new FormData(form);
                        const draft = {};
                        for (let [key, value] of formData.entries()) {
                            draft[key] = value;
                        }
                        localStorage.setItem('propertyDraft', JSON.stringify(draft));
                    }, 2000);
                });
            });
            
            // Load draft on page load
            const savedDraft = localStorage.getItem('propertyDraft');
            if (savedDraft) {
                const draft = JSON.parse(savedDraft);
                Object.keys(draft).forEach(key => {
                    const input = form.querySelector(`[name="${key}"]`);
                    if (input) {
                        input.value = draft[key];
                    }
                });
            }
        });
    </script>
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successPopup" class="popup-overlay success-popup">
        <div class="popup-content">
            <div class="success-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <h2>@TempData["SuccessMessage"]</h2>
            <p>Redirecionando para a lista de propriedades...</p>
        </div>
    </div>

    <script>
        const popup = document.getElementById("successPopup");
        popup.classList.add("show");

        setTimeout(function () {
            popup.classList.remove("show");
            popup.classList.add("fade-out");
            setTimeout(function() {
                window.location.href = '@Url.Action("Properties", "Home")';
            }, 300);
        }, 2500);
    </script>
}