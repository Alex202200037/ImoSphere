@model ImoSphere.Models.Property
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = "Adicionar Nova Propriedade";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var propertyModel = Model ?? new ImoSphere.Models.Property();
    var viewData = new ViewDataDictionary(ViewData);
    viewData.Remove("UserRole");
    viewData.Remove("IsCreate");
    viewData["UserRole"] = ViewBag.UserRole;
    viewData["IsCreate"] = ViewBag.IsCreate;
}

<link rel="stylesheet" href="~/css/property-form.css" asp-append-version="true" />

<!-- Hero Section -->
<section class="form-hero py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="form-header text-center">
                    <div class="form-icon">
                        <i class="fas fa-home fa-3x"></i>
                    </div>
                    <h1 class="form-title">@Localizer["AddNewPropertyTitle"]</h1>
                    <p class="form-subtitle">@Localizer["AddNewPropertySubtitle"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Form Section -->
<section class="form-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="form-card">
                    <form asp-action="Create" method="post" id="propertyForm" enctype="multipart/form-data">
                        @await Html.PartialAsync("_PropertyForm", Model, viewData)

                        <div class="form-actions">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <button type="submit" class="btn btn-primary btn-lg w-100">
                                        <i class="fas fa-plus me-2"></i>Adicionar Propriedade
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <a asp-controller="Home" asp-action="Properties"
                                        class="btn btn-outline-secondary btn-lg w-100">
                                        <i class="fas fa-times me-2"></i>Cancelar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Map Modal -->
<div id="mapModal" class="map-modal">
    <button type="button" id="closeMapBtn" class="map-close-btn"
        style="position:fixed; top:32px; right:32px; z-index:11000; background:rgba(0,0,0,0.7); color:#fff; border:none; border-radius:50%; width:48px; height:48px; font-size:2rem; display:flex; align-items:center; justify-content:center; box-shadow:0 2px 8px #0006; cursor:pointer;">
        <span aria-label="Fechar" style="pointer-events:none;">&times;</span>
    </button>
    <div class="map-container"
        style="background:#fff; border-radius:16px; margin:auto; box-shadow:0 0 32px #0002; display:flex; flex-direction:column; align-items:center; width:660px;">
        <div class="map-header"
            style="background:#8f4fff; color:#fff; border-radius:16px 16px 0 0; padding:16px 24px; width:100%; display:flex; align-items:center; justify-content:space-between; gap:16px;">
            <h3 style="margin:0; font-size:1.3rem; display:flex; align-items:center;"><i
                    class="fas fa-map-marker-alt me-2"></i>Selecionar Localização</h3>
            <button type="button" id="confirmMapBtn" class="btn btn-primary"
                style="min-width:120px; margin-left:auto;">Confirmar</button>
        </div>
        <div id="map" class="map-content" style="width:660px; height:760px; border-radius:0 0 0 0; flex-shrink:0;">
        </div>
        <div class="map-instructions" style="padding:8px 24px 0 24px; width:100%;">
            <p style="margin:0 0 8px 0;"><i class="fas fa-info-circle me-2"></i>Clique no mapa para selecionar a
                localização ou arraste o marcador</p>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // Form validation and enhancement
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('propertyForm');
            const submitBtn = form.querySelector('button[type="submit"]');

            // Add loading state to submit button
            form.addEventListener('submit', function () {
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>A processar...';
                submitBtn.disabled = true;
            });
        });
    </script>

    <script>
        // --- Autocomplete Nominatim ---
        let acTimeout;
        const locInput = document.getElementById('locationInput');
        const latInput = document.getElementById('latitudeInput');
        const lngInput = document.getElementById('longitudeInput');
        let acList = document.createElement('div');
        acList.className = 'autocomplete-list';
        acList.style.width = locInput.offsetWidth + 'px';
        locInput.parentNode.appendChild(acList);
        locInput.addEventListener('input', function () {
            clearTimeout(acTimeout);
            if (this.value.length < 3) { acList.style.display = 'none'; return; }
            acTimeout = setTimeout(() => {
                fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(this.value)}&addressdetails=1&limit=5`)
                    .then(res => res.json())
                    .then(data => {
                        acList.innerHTML = '';
                        data.forEach(item => {
                            let opt = document.createElement('div');
                            opt.className = 'autocomplete-item';
                            opt.textContent = item.display_name;
                            opt.onclick = () => {
                                locInput.value = item.display_name;
                                latInput.value = item.lat;
                                lngInput.value = item.lon;
                                acList.style.display = 'none';
                            };
                            acList.appendChild(opt);
                        });
                        acList.style.display = data.length ? 'block' : 'none';
                    });
            }, 300);
        });
        document.addEventListener('click', e => { if (!acList.contains(e.target) && e.target !== locInput) acList.style.display = 'none'; });
        // --- Modal do mapa ---
        const mapModal = document.getElementById('mapModal');
        const openMapBtn = document.getElementById('openMapBtn');
        const confirmMapBtn = document.getElementById('confirmMapBtn');
        let map, marker;
        openMapBtn.onclick = function () {
            mapModal.classList.add('show');
            setTimeout(() => { if (!map) initMap(); else map.invalidateSize(); }, 100);
        };
        // Fechar modal ao clicar em Confirmar
        confirmMapBtn.onclick = function () { mapModal.classList.remove('show'); };
        // Adicionar funcionalidade ao botão de fechar
        const closeMapBtn = document.getElementById('closeMapBtn');
        closeMapBtn.onclick = function () { mapModal.classList.remove('show'); };
        document.addEventListener('keydown', function (e) {
            if (mapModal.classList.contains('show') && e.key === 'Escape') {
                mapModal.classList.remove('show');
            }
        });
        function initMap() {
            let lat = parseFloat(latInput.value) || 38.7223;
            let lng = parseFloat(lngInput.value) || -9.1393;
            map = L.map('map').setView([lat, lng], 7);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap'
            }).addTo(map);
            marker = L.marker([lat, lng], { draggable: true }).addTo(map);
            marker.on('dragend', function (e) {
                let pos = marker.getLatLng();
                latInput.value = pos.lat;
                lngInput.value = pos.lng;
                fetch(`https://nominatim.openstreetmap.org/reverse?lat=${pos.lat}&lon=${pos.lng}&format=json`)
                    .then(res => res.json())
                    .then(data => { locInput.value = data.display_name || `${pos.lat},${pos.lng}`; });
            });
            map.on('click', function (e) {
                marker.setLatLng(e.latlng);
                latInput.value = e.latlng.lat;
                lngInput.value = e.latlng.lng;
                fetch(`https://nominatim.openstreetmap.org/reverse?lat=${e.latlng.lat}&lon=${e.latlng.lng}&format=json`)
                    .then(res => res.json())
                    .then(data => { locInput.value = data.display_name || `${e.latlng.lat},${e.latlng.lng}`; });
            });
        }
    </script>
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="successPopup" class="popup-overlay success-popup">
        <div class="popup-content">
            <div class="success-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <h2>@TempData["SuccessMessage"]</h2>
            <p>Redirecionando para a lista de propriedades...</p>
        </div>
    </div>

    <script>
        const popup = document.getElementById("successPopup");
        popup.classList.add("show");

        setTimeout(function () {
            popup.classList.remove("show");
            popup.classList.add("fade-out");
            setTimeout(function () {
                window.location.href = '@Url.Action("Properties", "Home")';
            }, 300);
        }, 2500);
    </script>
}