@model ImoSphere.Models.Property

@{
    ViewData["Title"] = "Detalhes da Propriedade";
    bool isSeller = ViewBag.IsSeller ?? false;
    bool canContact = ViewBag.CanContact ?? false;
    string comercialName = ViewBag.ComercialName as string;
    string comercialId = ViewBag.ComercialId as string;
    string agencyLogo = ViewBag.AgencyLogo as string;
}

<head>
    <link rel="stylesheet" href="~/css/property-details.css" asp-append-version="true" />
</head>

@Html.AntiForgeryToken()

<section class="property-details container">
    <div class="details-header d-flex align-items-center">
        @if (!string.IsNullOrEmpty(agencyLogo))
        {
            <img src="@agencyLogo" alt="Agência" class="agency-logo-details" />
        }
        <h1 class="text-center property-title">@Model.Name</h1>
    </div>
    <div class="details-content row mt-4">
        <div class="col-md-7">
            <div class="details-image mb-4">
                <!-- Carrossel de imagens principal -->
                <div class="property-carousel-main position-relative" id="propertyCarouselMain">
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        for (int i = 0; i < Model.Images.Count(); i++)
                        {
                            var img = Model.Images.ElementAt(i);
                            <img src="@img.ImageUrl" alt="@Model.Name" class="carousel-img-main @(i == 0 ? "active" : "")" data-index="@i" style="display:@(i == 0 ? "block" : "none");cursor:pointer;" onclick="openImageModal(@i)" />
                        }
                    }
                    else
                    {
                        <img src="/images/house-casas-1.png" alt="@Model.Name" class="carousel-img-main active" data-index="0" style="display:block;cursor:pointer;" onclick="openImageModal(0)" />
                    }
                    <button class="carousel-arrow-main left" type="button" aria-label="Anterior" onclick="carouselPrev()"><i class="fas fa-chevron-left"></i></button>
                    <button class="carousel-arrow-main right" type="button" aria-label="Seguinte" onclick="carouselNext()"><i class="fas fa-chevron-right"></i></button>
                    <div class="carousel-dots-main"></div>
                </div>
            </div>
            <!-- Miniaturas logo por baixo do carrossel -->
            <div class="property-thumbnails mt-3">
                @if (Model.Images != null && Model.Images.Count() > 1)
                {
                    for (int i = 0; i < Model.Images.Count(); i++)
                    {
                        var img = Model.Images.ElementAt(i);
                        <img src="@img.ImageUrl" alt="@Model.Name" class="property-thumb-img" data-index="@i" onclick="openImageModal(@i)" />
                    }
                }
            </div>
            <!-- Modal para imagem grande -->
            <div id="imageModal" class="image-modal" style="display:none;">
                <span class="close-modal" onclick="closeImageModal()">&times;</span>
                <button class="modal-arrow left" onclick="modalPrev(event)"><i class="fas fa-chevron-left"></i></button>
                <img class="image-modal-content" id="modalImage" src="" alt="Imagem grande" />
                <button class="modal-arrow right" onclick="modalNext(event)"><i class="fas fa-chevron-right"></i></button>
            </div>
        </div>
        <div class="col-md-5">
            <div class="details-meta mb-3">
                <div class="meta-box" style="min-width:160px;">
                    <span class="meta-box-content">@Model.Location</span>
                </div>
                <div class="meta-box" style="min-width:160px;">
                    <span class="meta-box-price">@Model.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-PT"))</span>
                </div>
            </div>
            <div class="mb-3">
                <h4 class="section-title">Descrição</h4>
                <p class="section-description">@Model.Description</p>
            </div>
            <div class="mb-3">
                <h4 class="section-title">Características</h4>
                <ul class="property-features d-flex flex-wrap gap-3" style="list-style:none;padding:0;">
                    <li><span title="Quartos">🛏️</span> <b>@Model.Bedrooms</b></li>
                    <li><span title="WC's">🛁</span> <b>@Model.Bathrooms</b></li>
                    <li><span title="Área">📐</span> <b>@Model.Area m²</b></li>
                    <li><span title="Ano">🏗️</span> <b>@Model.YearBuilt</b></li>
                </ul>
            </div>
            @if (canContact)
            {
                <div class="contact-block p-3 mb-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="contact-label">Comercial responsável:</span>
                        <span class="contact-value">@comercialName</span>
                    </div>
                    @if (ViewBag.HasConversation == true)
                    {
                        <a href="/Chat/Index?propertyId=@Model.Id&comercialId=@comercialId" class="btn btn-primary w-100">Abrir Chat</a>
                    }
                    else
                    {
                        <form method="post" action="/Chat/StartContactSend" class="mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="propertyId" value="@Model.Id" />
                            <input type="hidden" name="comercialId" value="@comercialId" />
                            <textarea name="message" class="form-control mb-2 textarea-no-resize" rows="2" placeholder="Escreva a sua mensagem para o comercial..." required></textarea>
                            <button type="submit" class="btn btn-primary w-100">Contactar via Chat</button>
                        </form>
                    }
                </div>
            }
            @if (isSeller)
            {
                <div class="d-grid gap-2">
                    <a class="btn btn-outline-warning" href="/Properties/Edit/@Model.Id">Editar Propriedade</a>
                    <form method="post" action="/Properties/Delete/@Model.Id" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Tem a certeza que deseja eliminar esta propriedade? Esta ação não pode ser desfeita.');">
                            Eliminar Propriedade
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</section>

<script>
    // Variáveis globais para o carrossel principal
    let currentCarouselIndex = 0;
    let carouselImages = [];
    let carouselInterval = null;
    let isAutoPlaying = true;

    // Inicializar o carrossel quando a página carrega
    document.addEventListener('DOMContentLoaded', function() {
        carouselImages = Array.from(document.querySelectorAll('.carousel-img-main'));
        updateCarouselDots();
        
        // Iniciar auto-play se há mais de 1 imagem
        if (carouselImages.length > 1) {
            startAutoPlay();
        }
        
        // Pausar auto-play ao fazer hover no carrossel
        const carouselContainer = document.getElementById('propertyCarouselMain');
        if (carouselContainer) {
            carouselContainer.addEventListener('mouseenter', pauseAutoPlay);
            carouselContainer.addEventListener('mouseleave', startAutoPlay);
        }
    });

    // Função para iniciar auto-play
    function startAutoPlay() {
        if (carouselImages.length <= 1) return;
        
        isAutoPlaying = true;
        if (carouselInterval) {
            clearInterval(carouselInterval);
        }
        
        carouselInterval = setInterval(() => {
            if (isAutoPlaying) {
                carouselNext();
            }
        }, 4000); // Passa a cada 4 segundos
    }

    // Função para pausar auto-play
    function pauseAutoPlay() {
        isAutoPlaying = false;
        if (carouselInterval) {
            clearInterval(carouselInterval);
            carouselInterval = null;
        }
    }

    // Função para avançar no carrossel principal
    function carouselNext() {
        if (carouselImages.length <= 1) return;
        
        // Esconder imagem atual
        carouselImages[currentCarouselIndex].style.display = 'none';
        carouselImages[currentCarouselIndex].classList.remove('active');
        
        // Avançar para próxima imagem
        currentCarouselIndex = (currentCarouselIndex + 1) % carouselImages.length;
        
        // Mostrar nova imagem
        carouselImages[currentCarouselIndex].style.display = 'block';
        carouselImages[currentCarouselIndex].classList.add('active');
        
        updateCarouselDots();
    }

    // Função para recuar no carrossel principal
    function carouselPrev() {
        if (carouselImages.length <= 1) return;
        
        // Esconder imagem atual
        carouselImages[currentCarouselIndex].style.display = 'none';
        carouselImages[currentCarouselIndex].classList.remove('active');
        
        // Recuar para imagem anterior
        currentCarouselIndex = (currentCarouselIndex - 1 + carouselImages.length) % carouselImages.length;
        
        // Mostrar nova imagem
        carouselImages[currentCarouselIndex].style.display = 'block';
        carouselImages[currentCarouselIndex].classList.add('active');
        
        updateCarouselDots();
    }

    // Função para atualizar os dots do carrossel
    function updateCarouselDots() {
        const dotsContainer = document.querySelector('.carousel-dots-main');
        if (!dotsContainer) return;
        
        // Limpar dots existentes
        dotsContainer.innerHTML = '';
        
        // Criar novos dots
        for (let i = 0; i < carouselImages.length; i++) {
            const dot = document.createElement('span');
            dot.className = 'carousel-dot';
            if (i === currentCarouselIndex) {
                dot.classList.add('active');
            }
            dot.onclick = () => goToSlide(i);
            dotsContainer.appendChild(dot);
        }
    }

    // Função para ir para uma slide específica
    function goToSlide(index) {
        if (index === currentCarouselIndex || index < 0 || index >= carouselImages.length) return;
        
        // Esconder imagem atual
        carouselImages[currentCarouselIndex].style.display = 'none';
        carouselImages[currentCarouselIndex].classList.remove('active');
        
        // Ir para nova imagem
        currentCarouselIndex = index;
        
        // Mostrar nova imagem
        carouselImages[currentCarouselIndex].style.display = 'block';
        carouselImages[currentCarouselIndex].classList.add('active');
        
        updateCarouselDots();
        
        // Reiniciar auto-play após navegação manual
        if (carouselImages.length > 1) {
            startAutoPlay();
        }
    }

    function confirmDelete(propertyId, propertyName) {
        if (confirm(`Tem a certeza que deseja eliminar a propriedade "${propertyName}"?\n\nEsta ação não pode ser desfeita.`)) {
            // Criar form para enviar o POST
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/Properties/Delete/${propertyId}`;
            form.style.display = 'none';
            // Adicionar token CSRF
            const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (csrfToken) {
                const csrfInput = document.createElement('input');
                csrfInput.type = 'hidden';
                csrfInput.name = '__RequestVerificationToken';
                csrfInput.value = csrfToken;
                form.appendChild(csrfInput);
            }
            document.body.appendChild(form);
            form.submit();
        }
    }

    // Garantir que as imagens do carrossel e miniaturas estão disponíveis para o modal
    function getAllImageUrls() {
        return Array.from(document.querySelectorAll('.carousel-img-main')).map(img => img.src);
    }
    let modalIdx = 0;
    function openImageModal(idx) {
        const urls = getAllImageUrls();
        modalIdx = idx;
        document.getElementById('modalImage').src = urls[modalIdx];
        document.getElementById('imageModal').style.display = 'flex';
        document.getElementById('imageModal').style.alignItems = 'center';
        document.getElementById('imageModal').style.justifyContent = 'center';
    }
    function closeImageModal() {
        document.getElementById('imageModal').style.display = 'none';
        document.getElementById('modalImage').src = '';
    }
    function modalPrev(e) {
        e.stopPropagation();
        const urls = getAllImageUrls();
        modalIdx = (modalIdx - 1 + urls.length) % urls.length;
        document.getElementById('modalImage').src = urls[modalIdx];
    }
    function modalNext(e) {
        e.stopPropagation();
        const urls = getAllImageUrls();
        modalIdx = (modalIdx + 1) % urls.length;
        document.getElementById('modalImage').src = urls[modalIdx];
    }
    window.onclick = function(event) {
        const modal = document.getElementById('imageModal');
        if (event.target === modal) {
            closeImageModal();
        }
    }
</script>