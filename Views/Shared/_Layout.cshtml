@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ImoSphere</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/popups.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/map.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/property-images.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/users-management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/properties.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ImoSphere.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/glass.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Leaflet CSS para OpenStreetMap -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" 
          crossorigin="" />
    
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    
    <style>
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark glass-navbar">
            <div class="container">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                    <i class="fas fa-building me-2"></i>ImoSphere
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("AboutUs", "Home")">
                                <i class="fas fa-info-circle me-1"></i>@Localizer["AboutUs"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Properties", "Home")">
                                <i class="fas fa-home me-1"></i>@Localizer["Properties"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Services", "Home")">
                                <i class="fas fa-cogs me-1"></i>@Localizer["Services"]
                            </a>
                        </li>
                        @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")))
                        {
                            <li class="nav-item">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="nav-link" href="@Url.Action("Perfil", "Home")?tab=users">
                                        <i class="fas fa-users me-1"></i>@Localizer["ManageUsers"]
                                    </a>
                                }
                                else
                                {
                                    <a class="nav-link" href="@Url.Action("Users", "Admin")">
                                        <i class="fas fa-users me-1"></i>@Localizer["ManageUsers"]
                                    </a>
                                }
                            </li>
                        }
                        @if (User.Identity.IsAuthenticated && User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item position-relative">
                                <a class="nav-link" href="@Url.Action("ContactUsMessages", "Home")">
                                    <i class="fas fa-envelope me-1"></i>@Localizer["Messages"]
                                    @if (ViewBag.UnreadContactUsCount != null && (int)ViewBag.UnreadContactUsCount > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.8em;">@ViewBag.UnreadContactUsCount</span>
                                    }
                                </a>
                            </li>
                        }
                        else if (!User.Identity.IsAuthenticated || User.IsInRole("User") || User.IsInRole("Comercial"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("ContactUs", "Home")">
                                    <i class="fas fa-phone me-1"></i>@Localizer["ContactUs"]
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <ul class="navbar-nav">
                        <!-- Seletor de Idioma -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="langDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="me-1">
                                    @if (System.Threading.Thread.CurrentThread.CurrentUICulture.Name.StartsWith("pt")) {
                                        <img src="/images/flags/pt.png" alt="PT" width="20" class="me-1" />
                                    } else if (System.Threading.Thread.CurrentThread.CurrentUICulture.Name.StartsWith("en")) {
                                        <img src="/images/flags/en.png" alt="EN" width="20" class="me-1" />
                                    } else if (System.Threading.Thread.CurrentThread.CurrentUICulture.Name.StartsWith("es")) {
                                        <img src="/images/flags/es.png" alt="ES" width="20" class="me-1" />
                                    }
                                </span>
                                @System.Threading.Thread.CurrentThread.CurrentUICulture.DisplayName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="langDropdown">
                                <li>
                                    <form method="post" action="/Language/SetLanguage" class="d-inline">
                                        <input type="hidden" name="culture" value="pt" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="dropdown-item d-flex align-items-center">
                                            <img src="/images/flags/pt.png" alt="PT" width="20" class="me-2" /> Português
                                        </button>
                                    </form>
                                </li>
                                <li>
                                    <form method="post" action="/Language/SetLanguage" class="d-inline">
                                        <input type="hidden" name="culture" value="en" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="dropdown-item d-flex align-items-center">
                                            <img src="/images/flags/en.png" alt="EN" width="20" class="me-2" /> English
                                        </button>
                                    </form>
                                </li>
                                <li>
                                    <form method="post" action="/Language/SetLanguage" class="d-inline">
                                        <input type="hidden" name="culture" value="es" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="dropdown-item d-flex align-items-center">
                                            <img src="/images/flags/es.png" alt="ES" width="20" class="me-2" /> Español
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link position-relative" href="@Url.Action("Index", "Chat")" id="chatLink">
                                    <i class="fas fa-comments me-1"></i>@Localizer["Chat"]
                                    <span id="unreadBadge" class="badge bg-danger position-absolute top-0 start-100 translate-middle" style="display:none;font-size:0.7rem;min-width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;"></span>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle me-1"></i>@Localizer["Profile"]
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" href="@Url.Action("Perfil", "Home")">
                                        <i class="fas fa-user me-2"></i>@Localizer["MyProfile"]
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form action="@Url.Action("Logout", "Account")" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fas fa-sign-out-alt me-2"></i>@Localizer["Logout"]
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary" href="@Url.Action("Login", "Account")">
                                    <i class="fas fa-sign-in-alt me-1"></i>@Localizer["Login"]
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="page-container">
        <div class="container">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-0">&copy; 2025 - ImoSphere - Premium Real Estate Management</p>
                </div>
                <div class="col-md-6 text-end">
                    <a href="@Url.Action("Privacy", "Home")" class="text-decoration-none">
                        <i class="fas fa-shield-alt me-1"></i>@Localizer["PrivacyPolicy"]
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity.IsAuthenticated)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
        <script>
            // Notificações globais para utilizadores autenticados
            const globalConnection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .build();
            
            globalConnection.on("ReceiveNotification", (message, count) => {
                const badge = document.getElementById("unreadBadge");
                if (badge) {
                    badge.textContent = count;
                    badge.style.display = count > 0 ? "inline-flex" : "none";
                }
                
                // Mostrar notificação toast
                if (count > 0) {
                    showToast("Nova mensagem recebida!", "info");
                }
            });
            
            globalConnection.start().then(() => {
                // Entrar no grupo global do utilizador
                const userId = "@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value";
                if (userId) {
                    globalConnection.invoke("JoinUserGroup", userId).catch(err => console.error(err.toString()));
                }
            }).catch(err => console.error(err.toString()));
            
            function showToast(message, type = "info") {
                // Criar toast notification
                const toast = document.createElement("div");
                toast.className = `toast-notification ${type}`;
                toast.innerHTML = `
                    <div class="alert alert-${type === 'info' ? 'info' : type === 'success' ? 'success' : 'warning'} alert-dismissible fade show" role="alert">
                        <i class="fas fa-${type === 'info' ? 'info-circle' : type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
                toast.style.cssText = "position:fixed;top:20px;right:20px;z-index:9999;min-width:300px;animation:fadeIn 0.3s ease;";
                document.body.appendChild(toast);
                
                setTimeout(() => {
                    toast.style.animation = "fadeOut 0.3s ease";
                    setTimeout(() => {
                        if (document.body.contains(toast)) {
                            document.body.removeChild(toast);
                        }
                    }, 300);
                }, 5000);
            }
        </script>
    }
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    
    <!-- Leaflet JS para OpenStreetMap -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" 
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" 
            crossorigin=""></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
